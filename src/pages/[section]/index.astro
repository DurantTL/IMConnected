---
import SectionList from '../../components/SectionList.astro';
import { getSection } from '../../lib/site';
import { getPublicStories } from '../../lib/public-stories';
import { bySection } from '../../lib/stories';

// Rendered on the server from the stories table (epic #25, step 2); the middleware caches the result.
export const prerender = false;

const section = getSection(Astro.params.section ?? '');
if (!section) return new Response(null, { status: 404 });
const stories = bySection(await getPublicStories(), section.key);
---
<SectionList section={section} stories={stories} />
