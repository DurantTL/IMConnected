---
import SectionList from '../../components/SectionList.astro';
import { getSection } from '../../lib/site';
import { asUnavailable, getPublicStories } from '../../lib/public-stories';
import { bySection } from '../../lib/stories';
import { PAGE_SIZE, pageCount } from '../../lib/pagination';

// Rendered on the server from the stories table (epic #25, step 2); the middleware caches the result.
export const prerender = false;

const section = getSection(Astro.params.section ?? '');
const area = section?.areas?.find((a) => a.key === Astro.params.area);
if (!section || !area) return new Response(null, { status: 404 });
let all: Awaited<ReturnType<typeof getPublicStories>>;
try {
  all = await getPublicStories();
} catch (err) {
  return asUnavailable(err);
}
const matching = bySection(all, section.key, area.key);
const pages = pageCount(matching.length);
const stories = matching.slice(0, PAGE_SIZE);
---
<SectionList section={section} area={area} stories={stories} pages={pages} />
