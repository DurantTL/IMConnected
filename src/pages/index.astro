---
import Base from '../layouts/Base.astro';
import StoryCard from '../components/StoryCard.astro';
import EventSpotlight from '../components/EventSpotlight.astro';
import { upcomingEvents, conferenceDay } from '../lib/event-spotlight';
import { SECTIONS, SITE, getSection, formatDate } from '../lib/site';
import { asUnavailable, getPublicStories, homepageStories, HOMEPAGE_RECENT_DAYS } from '../lib/public-stories';
import { archiveRail, ARCHIVE_LINK, ARCHIVE_LINK_LABEL } from '../lib/archive-rail';
import { bySection } from '../lib/stories';
import { latestIssue, issueHref, PREVIEW_COUNT } from '../lib/issue-pages';

// Rendered on the server from the stories table; the middleware caches the result.
export const prerender = false;

let stories: Awaited<ReturnType<typeof getPublicStories>>;
try {
  stories = await getPublicStories();
} catch (err) {
  return asUnavailable(err);
}
// Every block below draws from the recent pool only (last 90 days plus featured); section pages still list everything.
const allStories = stories;
stories = homepageStories(allStories);

// Hero: featured stories first, then newest
const featured = stories.filter((s) => s.data.featured);
const heroPool = [...featured, ...stories.filter((s) => !s.data.featured)];
const [lead, ...rest] = heroPool;
const side = rest.slice(0, 3);
const used = new Set([lead, ...side].filter(Boolean).map((s) => s.id));
const fresh = (list: typeof stories) => list.filter((s) => !used.has(s.id));

const news = getSection('news')!;
const features = fresh(bySection(stories, 'features')).slice(0, 3);
const columns = bySection(stories, 'columns').slice(0, 3);
const youth = fresh(bySection(stories, 'youth')).slice(0, 3);
const kids = bySection(stories, 'kids').slice(0, 3);
const newsAreas = news.areas!.map((a) => ({ area: a, items: bySection(stories, 'news', a.key).slice(0, 3) }));
// "Latest issue" (issue #115): from the same live stories as /issues/, no extra query.
const latest = latestIssue(allStories);
const sentOn = latest ? formatDate(new Date(`${latest.date}T00:00:00.000Z`)) : '';
const spotlight = upcomingEvents(allStories);
// "From the archive" (issue #100): older stories, never one already shown above.
const shownAbove = [...spotlight, ...(latest?.stories.slice(0, PREVIEW_COUNT) ?? []), lead, ...side, ...features, ...newsAreas.flatMap((a) => a.items), ...columns, ...youth, ...kids].filter(Boolean).map((s) => s!.id);
const archive = archiveRail(allStories, { today: conferenceDay(), recentDays: HOMEPAGE_RECENT_DAYS, exclude: shownAbove });
---
<Base current="home">
  <div class="wrap magazine-home">
    <section class="home-intro" aria-labelledby="home-title" data-reveal>
      <div>
        <p class="eyebrow">The conference story magazine</p>
        <h1 id="home-title">A connected community.<br /><em>A living faith.</em></h1>
      </div>
      <p class="home-intro-note">{SITE.tagline}.<br /><a class="intro-link" href="/news/">Discover what’s happening <span aria-hidden="true">→</span></a></p>
      {latest && <p class="latest-issue-line"><a href={issueHref(latest.number)}>Latest issue: No. {latest.number} · <time datetime={latest.date}>{sentOn}</time></a></p>}
    </section>
  </div>
  <EventSpotlight events={spotlight} />
  <div class="wrap magazine-home">
    <div class="home-news-heading"><p class="eyebrow">Faith in action. Close to home.</p><h2>Stories worth sharing.</h2><a href="/news/">The latest news <span aria-hidden="true">↗</span></a></div>
    {lead ? (
      <section class="hero" aria-label="Top stories">
        <StoryCard story={lead} variant="lead" />
        <aside class="hero-side" aria-labelledby="latest-title">
          <div class="latest-heading"><span class="eyebrow">The latest</span><h2 id="latest-title">From around our conference</h2></div>
          <ol class="latest-stories">{side.map((s, i) => <li><span class="latest-number" aria-hidden="true">0{i + 1}</span><StoryCard story={s} variant="compact" /></li>)}</ol>
          <a class="intro-link" href="/news/">All conference news <span aria-hidden="true">→</span></a>
        </aside>
      </section>
    ) : (
      <p class="empty-state">No stories yet — check back soon.</p>
    )}

    {latest && (
      <section class="block latest-issue" aria-labelledby="latest-issue-title">
        <div class="block-head">
          <div>
            <p class="eyebrow">Latest issue</p>
            <h2 id="latest-issue-title"><a href={issueHref(latest.number)}>Issue No. {latest.number}{latest.title && <><span class="sr-only">: </span><span class="latest-issue-name">{latest.title}</span></>}</a></h2>
            <p>Sent <time datetime={latest.date}>{sentOn}</time> · {latest.stories.length} {latest.stories.length === 1 ? 'story' : 'stories'}</p>
          </div>
          <a class="more" href={issueHref(latest.number)}>{latest.stories.length > PREVIEW_COUNT ? `See all ${latest.stories.length} stories` : 'Open this issue'}<span class="sr-only"> in Issue No. {latest.number}</span> <span aria-hidden="true">→</span></a>
        </div>
        <div class="grid cols-3">{latest.stories.slice(0, PREVIEW_COUNT).map((s) => <StoryCard story={s} />)}</div>
      </section>
    )}

    <nav class="topic-directory" aria-label="Explore story sections">
      <span class="topic-directory-label">Find your next story</span>
      {SECTIONS.map((s) => <a href={`/${s.key}/`} data-sec={s.key}><span>{s.short}</span><span class="topic-count">{bySection(allStories, s.key).length} {bySection(allStories, s.key).length === 1 ? 'story' : 'stories'} <span aria-hidden="true">↗</span></span></a>)}
    </nav>

    {features.length > 0 && (
      <section class="block" data-sec="features">
        <div class="block-head">
          <div><h2>Features</h2><p>{getSection('features')!.blurb}</p></div>
          <a class="more" href="/features/">All features →</a>
        </div>
        <div class="grid cols-3">{features.map((s) => <StoryCard story={s} />)}</div>
      </section>
    )}

    <section class="block community-section" data-sec="news">
      <div class="block-head">
          <div><p class="eyebrow">Local stories. Shared purpose.</p><h2>Across the Conference</h2><p>{news.blurb}</p></div>
        <a class="more" href="/news/">All news →</a>
      </div>
      <div class="grid cols-4">
        {newsAreas.map(({ area: a, items }) => {
          return (
            <div class:list={['area-col', { 'area-empty': !items.length }]} data-sec="news">
              <h3 class="area-title"><a href={`/news/${a.key}/`}>{a.label}<span aria-hidden="true">↗</span></a></h3>
              {items.length ? items.map((s) => <StoryCard story={s} variant="text" showDek={false} showKicker={false} />) : <div class="area-invitation"><p class="empty">Your community’s next story belongs here.</p><a href="/submit/">Share a story <span aria-hidden="true">→</span></a></div>}
            </div>
          );
        })}
      </div>
    </section>

    {columns.length > 0 && (
      <section class="block voices-section" data-sec="columns">
        <div class="block-head">
          <div><p class="eyebrow">A moment to reflect</p><h2>Voices &amp; perspectives</h2><p>{getSection('columns')!.blurb}</p></div>
          <a class="more" href="/columns/">All columns →</a>
        </div>
        <div class="grid cols-3">{columns.map((s) => <StoryCard story={s} variant="text" />)}</div>
      </section>
    )}

    {youth.length > 0 && (
      <section class="block" data-sec="youth">
        <div class="block-head">
          <div><h2>Youth &amp; Pathfinders</h2><p>{getSection('youth')!.blurb}</p></div>
          <a class="more" href="/youth/">More youth news →</a>
        </div>
        <div class="grid cols-3">{youth.map((s) => <StoryCard story={s} />)}</div>
      </section>
    )}

    {kids.length > 0 && (
      <section class="block" data-sec="kids">
        <div class="block-head">
          <div><h2>Kids</h2><p>{getSection('kids')!.blurb}</p></div>
          <a class="more" href="/kids/">More for kids →</a>
        </div>
        <div class="grid cols-3">{kids.map((s) => <StoryCard story={s} />)}</div>
      </section>
    )}

    {archive.length > 0 && (
      <section class="block archive-rail" aria-labelledby="archive-title">
        <div class="block-head">
          <div><p class="eyebrow">Past issues</p><h2 id="archive-title">From the archive</h2><p>Stories from past issues of IMConnected</p></div>
          <a class="more" href={ARCHIVE_LINK}>{ARCHIVE_LINK_LABEL} →</a>
        </div>
        <div class="grid cols-4">{archive.map((s) => <StoryCard story={s} hideArea />)}</div>
      </section>
    )}

    <section class="cta" aria-label="Submit a story">
      <div>
        <p class="eyebrow">Every community has a story</p>
        <h2>Let’s tell yours.</h2>
        <p>Baptisms, outreach, school events, Pathfinder adventures, answered prayers — share what God is doing in your community.</p>
      </div>
      <a class="btn accent" href="/submit/">Submit a Story</a>
    </section>
  </div>
</Base>
