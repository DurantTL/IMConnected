---
import Admin from '../../../layouts/Admin.astro';
import { rotateSession } from '../../../lib/auth/session';
import { checkPasskeyFactor, checkSecondFactor } from '../../../lib/auth/factor';
import { LOCKED_MESSAGE, recordSuccess } from '../../../lib/auth/ratelimit';
import { hasConfirmedTotp } from '../../../lib/auth/totp';
import { hasPasskey, parseJson, passkeysEnabled } from '../../../lib/auth/passkeys';
import { audit } from '../../../lib/auth/audit';
import { field, readForm } from '../../../lib/auth/form';
import { clientIp } from '../../../lib/request';
export const prerender = false;

// Step 2 of sign-in: an authenticator code, a recovery code, or one of the user's passkeys. The middleware guarantees a session here.
const user = Astro.locals.user!;
const session = Astro.locals.session!;
if (session.mfaPassed) return Astro.redirect('/admin');
const usesTotp = hasConfirmedTotp(user.id);
const usesPasskey = hasPasskey(user.id) && passkeysEnabled();
if (!usesTotp && !hasPasskey(user.id)) return Astro.redirect('/admin/2fa/setup');

let error = '';
if (Astro.request.method === 'POST') {
  const form = await readForm(Astro.request);
  const ip = clientIp(Astro.request, Astro.clientAddress);
  const passkey = form ? field(form, 'passkey', 20000) : '';
  const result = passkey
    ? await checkPasskeyFactor(user, parseJson(passkey), 'second_factor', ip)
    : checkSecondFactor(user, form ? field(form, 'code', 40) : '', ip);
  if (result === 'locked') {
    error = LOCKED_MESSAGE;
    Astro.response.status = 429;
  } else if (result === 'invalid') {
    error = passkey ? 'That passkey could not be verified. Please try again.' : 'That code is not valid.';
    Astro.response.status = 401;
  } else {
    // Callers must use the returned session; Astro.locals.session still holds the old id.
    const rotated = rotateSession(session.id, { mfaPassed: true, cookies: Astro.cookies });
    if (!rotated) return Astro.redirect('/admin/login', 303);
    recordSuccess(user.email);
    audit('auth.login', { userId: user.id, ip, detail: { method: result } });
    return Astro.redirect('/admin', 303);
  }
}
---
<Admin title="Two-factor check">
  <h1>Two-factor check</h1>
  <form class="admin-card" method="post" action="/admin/2fa">
    {error && <p class="admin-error" role="alert">{error}</p>}
    <p class="admin-note">{usesTotp ? 'Enter the 6-digit code from your authenticator app, or one of your recovery codes.' : 'Use your passkey, or enter one of your recovery codes.'}</p>
    <label for="code">Code</label>
    <input id="code" name="code" type="text" inputmode="text" autocomplete="one-time-code" autocapitalize="characters" spellcheck="false" required maxlength="40" />
    <button type="submit">Sign in</button>
  </form>
  {usesPasskey && (
    <form class="admin-card passkey-card" method="post" action="/admin/2fa">
      <input type="hidden" name="passkey" value="" />
      <h2>Passkey</h2>
      <p class="admin-error" role="alert" data-passkey-error hidden></p>
      <p class="admin-note">Confirm with the passkey on this device or your security key.</p>
      <button type="button" data-passkey="second" data-passkey-needs-js hidden>Use a passkey</button>
    </form>
  )}
  <form method="post" action="/api/admin/logout" class="admin-note"><button type="submit" class="admin-link">Cancel and sign out</button></form>
</Admin>
<script>import '../../../scripts/passkeys';</script>
