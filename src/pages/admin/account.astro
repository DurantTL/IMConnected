---
import Admin from '../../layouts/Admin.astro';
import { revokeAllForUser, revokeSession, rotateSession } from '../../lib/auth/session';
import { checkFreshFactor } from '../../lib/auth/factor';
import { countPasskeys, finishRegistration, listPasskeys, parseJson, passkeysEnabled, removePasskey, renamePasskey } from '../../lib/auth/passkeys';
import { hasConfirmedTotp } from '../../lib/auth/totp';
import { hashPassword, passwordProblem, verifyPassword } from '../../lib/auth/password';
import { LOCKED_MESSAGE, isLocked, releaseAttempt, reserveAttempt } from '../../lib/auth/ratelimit';
import { generateRecoveryCodes, remainingRecoveryCodes } from '../../lib/auth/recovery';
import { audit } from '../../lib/auth/audit';
import { field, readForm } from '../../lib/auth/form';
import { clientIp } from '../../lib/request';
import { getDb } from '../../lib/db';
export const prerender = false;

const user = Astro.locals.user!;
let session = Astro.locals.session!;
const ip = clientIp(Astro.request, Astro.clientAddress);
const db = getDb();

let message = '';
let error = '';
let codes: string[] | null = null;

/** Sensitive actions need a fresh second factor (TOTP, recovery code or a passkey), under the sign-in rate limits. */
async function fresh(form: FormData): Promise<boolean> {
  const r = await checkFreshFactor(user, form, ip);
  if (r === 'locked') {
    error = LOCKED_MESSAGE;
    Astro.response.status = 429;
    return false;
  }
  if (r === 'invalid') {
    error = 'That code or passkey is not valid.';
    Astro.response.status = 401;
    return false;
  }
  return true;
}

if (Astro.request.method === 'POST') {
  const form = await readForm(Astro.request);
  const action = form ? field(form, 'action', 40) : '';
  if (!form) {
    error = 'The form could not be read.';
  } else if (action === 'password') {
    const current = field(form, 'current', 1024);
    const next = field(form, 'next', 1024);
    const confirm = field(form, 'confirm', 1024);
    const stored = db.prepare('SELECT hash FROM password_credentials WHERE user_id = ?').get(user.id) as { hash: string } | undefined;
    const problem = passwordProblem(next, user.email);
    const locked = isLocked(ip, user.email);
    const attempt = locked ? [] : reserveAttempt(ip, user.email); // counted before the await
    const currentOk = !locked && !!stored && (await verifyPassword(current, stored.hash));
    if (currentOk) releaseAttempt(attempt);
    if (locked) {
      error = LOCKED_MESSAGE;
      Astro.response.status = 429;
    } else if (!currentOk) {
      audit('auth.password_change_failed', { userId: user.id, ip });
      error = 'Your current password is incorrect.';
      Astro.response.status = 401;
    } else if (problem) {
      error = problem;
    } else if (next !== confirm) {
      error = 'The two new passwords don’t match.';
    } else if (await fresh(form)) {
      db.prepare('UPDATE password_credentials SET hash = ?, updated_at = ? WHERE user_id = ?').run(await hashPassword(next), Date.now(), user.id);
      const rotated = rotateSession(session.id, { mfaPassed: true, cookies: Astro.cookies });
      if (!rotated) return Astro.redirect('/admin/login', 303);
      session = rotated.session;
      revokeAllForUser(user.id, session.id);
      audit('auth.password_changed', { userId: user.id, ip });
      audit('auth.sessions_revoked', { userId: user.id, ip, detail: { scope: 'others', reason: 'password_change' } });
      message = 'Password changed. Every other session was signed out.';
    }
  } else if (action === 'recovery') {
    if (await fresh(form)) {
      codes = generateRecoveryCodes(user.id);
      audit('auth.recovery_codes_generated', { userId: user.id, ip, detail: { reason: 'regenerate' } });
    }
  } else if (action === 'passkey_add') {
    const passkey = field(form, 'passkey', 20000);
    if (!passkeysEnabled()) error = 'Passkeys are not available on this site.';
    else if (!passkey) error = 'No passkey was received. Please try again.';
    else if (await fresh(form)) {
      const res = await finishRegistration(user, parseJson(passkey), field(form, 'name', 80));
      if (res.result === 'ok') {
        audit('auth.passkey_registered', { userId: user.id, ip });
        message = 'Passkey added.';
      } else {
        audit('auth.passkey_failed', { userId: user.id, ip, detail: { reason: res.result, purpose: 'register' } });
        error = res.result === 'duplicate' ? 'That passkey is already registered.' : res.result === 'expired' ? 'That request expired. Please try again.' : 'That passkey could not be registered. Please try again.';
        Astro.response.status = 400;
      }
    }
  } else if (action === 'passkey_rename') {
    if (renamePasskey(user.id, field(form, 'id', 1400), field(form, 'name', 80))) {
      audit('auth.passkey_renamed', { userId: user.id, ip });
      message = 'Passkey renamed.';
    } else error = 'Enter a name for the passkey.';
  } else if (action === 'passkey_remove') {
    const id = field(form, 'id', 1400);
    // Check before spending a code: the last second factor can never be removed.
    if (countPasskeys(user.id) <= 1 && !hasConfirmedTotp(user.id)) {
      audit('auth.passkey_remove_refused', { userId: user.id, ip, detail: { reason: 'last_factor' } });
      error = 'You can’t remove your last second factor. Add an authenticator app or another passkey first.';
      Astro.response.status = 409;
    } else if (await fresh(form)) {
      const res = removePasskey(user.id, id);
      if (res === 'removed') {
        audit('auth.passkey_removed', { userId: user.id, ip });
        message = 'Passkey removed.';
      } else if (res === 'last_factor') {
        audit('auth.passkey_remove_refused', { userId: user.id, ip, detail: { reason: 'last_factor' } });
        error = 'You can’t remove your last second factor. Add an authenticator app or another passkey first.';
        Astro.response.status = 409;
      } else error = 'That passkey was not found.';
    }
  } else if (action === 'revoke') {
    // Sessions are named by the first 16 characters of their id, and only the user's own can match.
    const ref = field(form, 'ref', 40);
    const target = db.prepare('SELECT id FROM sessions WHERE user_id = ? AND substr(id, 1, 16) = ?').get(user.id, ref) as { id: string } | undefined;
    if (target && target.id !== session.id) {
      revokeSession(target.id);
      audit('auth.session_revoked', { userId: user.id, ip });
      message = 'Session signed out.';
    }
  } else if (action === 'notify') {
    const on = field(form, 'notify', 4) === '1';
    db.prepare('UPDATE users SET notify_submissions = ? WHERE id = ?').run(on ? 1 : 0, user.id);
    audit('account.notify_submissions', { userId: user.id, ip, detail: { enabled: on } });
    message = on ? 'You will get an email when a story is submitted.' : 'You will not get emails about new submissions.';
  } else if (action === 'revoke-others') {
    revokeAllForUser(user.id, session.id);
    audit('auth.sessions_revoked', { userId: user.id, ip, detail: { scope: 'others' } });
    message = 'All other sessions were signed out.';
  }
}

const sessions = db
  .prepare('SELECT id, created_at, last_seen_at, ip, user_agent FROM sessions WHERE user_id = ? ORDER BY last_seen_at DESC')
  .all(user.id) as { id: string; created_at: number; last_seen_at: number; ip: string | null; user_agent: string | null }[];
const notifyOn = (db.prepare('SELECT notify_submissions AS n FROM users WHERE id = ?').get(user.id) as { n: number } | undefined)?.n !== 0;
const remaining = remainingRecoveryCodes(user.id);
const passkeyList = listPasskeys(user.id);
const passkeysOn = passkeysEnabled();
const hasPk = passkeyList.length > 0 && passkeysOn;
const when = (ms: number) => new Date(ms).toISOString().replace('T', ' ').slice(0, 16) + ' UTC';
---
<Admin title="My account" current="account">
  <p class="admin-eyebrow">Site</p>
  <h1>My account</h1>
  <p class="admin-note">{user.name} · {user.email} · {user.role}</p>
  {message && <p class="admin-ok" role="status">{message}</p>}
  {error && <p class="admin-error" role="alert">{error}</p>}

  {codes && (
    <section class="admin-card" aria-labelledby="new-codes">
      <h2 id="new-codes">Your new recovery codes</h2>
      <p>The old codes no longer work. Each of these works <strong>once</strong>. They are shown only now.</p>
      <ol class="recovery-codes">{codes.map((c) => <li><code>{c}</code></li>)}</ol>
    </section>
  )}

  <section class="admin-card" aria-labelledby="nt">
    <h2 id="nt">Notifications</h2>
    <form method="post" action="/admin/account">
      <input type="hidden" name="action" value="notify" />
      <label class="notify-check"><input id="notify" name="notify" type="checkbox" value="1" checked={notifyOn} /> Email me when a story is submitted</label>
      <p class="admin-note">The email names only the story title and church, with a link to the draft. Contact details stay in the dashboard.</p>
      <button type="submit">Save</button>
    </form>
  </section>

  <section class="admin-card" aria-labelledby="pw">
    <h2 id="pw">Change password</h2>
    <form method="post" action="/admin/account" data-fresh-form data-has-passkeys={hasPk ? '' : undefined}>
      <input type="hidden" name="action" value="password" />
      <input type="hidden" name="assertion" value="" />
      <label for="current">Current password</label>
      <input id="current" name="current" type="password" autocomplete="current-password" required maxlength="1024" />
      <label for="next">New password</label>
      <input id="next" name="next" type="password" autocomplete="new-password" required minlength="12" maxlength="256" />
      <label for="confirm">Confirm new password</label>
      <input id="confirm" name="confirm" type="password" autocomplete="new-password" required minlength="12" maxlength="256" />
      <label for="pw-code">Authenticator or recovery code{hasPk ? ' (leave empty to confirm with a passkey)' : ''}</label>
      <input id="pw-code" name="code" type="text" autocomplete="one-time-code" required={!hasPk} maxlength="40" />
      <button type="submit">Change password</button>
    </form>
  </section>

  <section class="admin-card" aria-labelledby="rc">
    <h2 id="rc">Recovery codes</h2>
    <p>{remaining} of 10 unused. Codes can’t be shown again. Generating new ones replaces all of them.</p>
    <form method="post" action="/admin/account" data-fresh-form data-has-passkeys={hasPk ? '' : undefined}>
      <input type="hidden" name="action" value="recovery" />
      <input type="hidden" name="assertion" value="" />
      <label for="rc-code">Authenticator or recovery code{hasPk ? ' (leave empty to confirm with a passkey)' : ''}</label>
      <input id="rc-code" name="code" type="text" autocomplete="one-time-code" required={!hasPk} maxlength="40" />
      <p class="admin-error" role="alert" data-passkey-error hidden></p>
      <button type="submit">Generate new recovery codes</button>
    </form>
  </section>

  {(passkeysOn || passkeyList.length > 0) && (
    <section class="admin-card" aria-labelledby="pk">
      <h2 id="pk">Passkeys</h2>
      <p class="admin-note">A passkey signs you in without a password and also works as your second factor. Adding or removing one needs a fresh code or passkey.</p>
      <p class="admin-error" role="alert" data-passkey-error hidden></p>
      {passkeyList.length === 0 ? <p>No passkeys yet.</p> : (
        <ul class="session-list">
          {passkeyList.map((p) => (
            <li>
              <div>
                <strong>{p.device_name}</strong>
                <span class="admin-note"> · added {when(p.created_at)} · {p.last_used_at ? `last used ${when(p.last_used_at)}` : 'never used'}</span>
              </div>
              <form method="post" action="/admin/account" class="passkey-inline">
                <input type="hidden" name="action" value="passkey_rename" />
                <input type="hidden" name="id" value={p.id} />
                <label class="visually-hidden" for={`rn-${p.id.slice(0, 12)}`}>New name</label>
                <input id={`rn-${p.id.slice(0, 12)}`} name="name" type="text" required maxlength="60" value={p.device_name} />
                <button type="submit">Rename</button>
              </form>
              <form method="post" action="/admin/account" class="passkey-inline" data-fresh-form data-has-passkeys>
                <input type="hidden" name="action" value="passkey_remove" />
                <input type="hidden" name="id" value={p.id} />
                <input type="hidden" name="assertion" value="" />
                <label class="visually-hidden" for={`rm-${p.id.slice(0, 12)}`}>Authenticator or recovery code (leave empty to use a passkey)</label>
                <input id={`rm-${p.id.slice(0, 12)}`} name="code" type="text" autocomplete="one-time-code" maxlength="40" placeholder="Code, or leave empty to use a passkey" />
                <button type="submit">Remove</button>
              </form>
            </li>
          ))}
        </ul>
      )}
      {passkeysOn && (
        <form method="post" action="/admin/account" data-has-passkeys={hasPk ? '' : undefined}>
          <input type="hidden" name="action" value="passkey_add" />
          <input type="hidden" name="passkey" value="" />
          <input type="hidden" name="assertion" value="" />
          <label for="pk-name">Name for the new passkey (optional)</label>
          <input id="pk-name" name="name" type="text" maxlength="60" placeholder="Work laptop" />
          <label for="pk-code">Authenticator or recovery code{passkeyList.length > 0 ? ' (leave empty to confirm with a passkey)' : ''}</label>
          <input id="pk-code" name="code" type="text" autocomplete="one-time-code" maxlength="40" />
          <button type="button" data-passkey="register" data-passkey-needs-js hidden>Add a passkey</button>
          <p class="admin-note" data-passkey-unsupported hidden>This browser can’t use passkeys.</p>
        </form>
      )}
    </section>
  )}

  <section class="admin-card" aria-labelledby="sess">
    <h2 id="sess">Active sessions</h2>
    <ul class="session-list">
      {sessions.map((s) => (
        <li>
          <div>
            <strong>{s.id === session.id ? 'This session' : 'Signed in'}</strong>
            <span class="admin-note"> · {when(s.created_at)} · last active {when(s.last_seen_at)}</span>
            <div class="admin-note">{s.ip ?? 'unknown address'} · {(s.user_agent ?? 'unknown browser').slice(0, 80)}</div>
          </div>
          {s.id !== session.id && (
            <form method="post" action="/admin/account">
              <input type="hidden" name="action" value="revoke" />
              <input type="hidden" name="ref" value={s.id.slice(0, 16)} />
              <button type="submit">Sign out</button>
            </form>
          )}
        </li>
      ))}
    </ul>
    {sessions.length > 1 && (
      <form method="post" action="/admin/account">
        <input type="hidden" name="action" value="revoke-others" />
        <button type="submit">Sign out all other sessions</button>
      </form>
    )}
  </section>

  <form method="post" action="/api/admin/logout"><button type="submit" class="admin-link">Sign out</button></form>
</Admin>
<script>import '../../scripts/passkeys';</script>
