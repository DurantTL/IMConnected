---
import { countStoryBlocks } from '../../../lib/story-blocks';
import { isMediaMarkerLine, parsePhotoMarker, galleryMarker } from '../../../lib/story-media';
import { paragraphLines } from '../../../lib/story-media-render';
import Admin from '../../../layouts/Admin.astro';
import { photoFocusStyle, photoFrameAttrs } from '../../../lib/story-blocks';
import { SECTIONS } from '../../../lib/site';
import { LIMITS } from '../../../lib/limits';
import { PHOTO_LAYOUTS } from '../../../lib/photo-layouts';
import { SOURCE_LABEL, STATUS_LABEL, getDraft, isEditable, listPhotos } from '../../../lib/drafts';
import { noticeText, fmtTime, looksLikeEmail, sectionLabel } from '../../../lib/admin-ui';
import { errorText } from '../../../lib/messages';
import { siteUrl } from '../../../lib/draft-http';
import { listIssues } from '../../../lib/newsletter-issues';
import { driveConfig } from '../../../lib/db/gdrive.mjs';
import { fmtChicago, msToChicagoInput, errorTextFor, MAX_FAILURES, STOP_AT_ONCE } from '../../../lib/scheduled-publish';
import '../../../styles/story-builder.css';
import '../../../styles/admin-editor.css';
export const prerender = false;

const id = /^\d{1,12}$/.test(Astro.params.id ?? '') ? Number(Astro.params.id) : null;
const draft = id === null ? null : getDraft(id);
if (!draft) {
  Astro.response.status = 404;
}
const photos = draft ? listPhotos(draft.id) : [];
const issues = draft ? listIssues() : [];
const editable = draft ? isEditable(draft) : false;
const q = Astro.url.searchParams;
const published = q.get('n') === 'published';
const movedAt = ['photo_moved', 'photos'].includes(q.get('n') ?? '') && /^\d{1,3}$/.test(q.get('pos') ?? '') && /^\d{1,3}$/.test(q.get('of') ?? '') ? `Photo moved to position ${q.get('pos')} of ${q.get('of')}.` : '';
const notice = movedAt || noticeText(q.get('n'));
// With JavaScript a photo move or replace is announced through #photo-reorder-live after the page settles (photo-reorder.ts removes this status's role then); without it the status below is announced as usual.
const photoNotice = ['photo_moved', 'photos', 'photos_markers', 'photo_replaced', 'photo_unchanged'].includes(q.get('n') ?? '') && /^\d{1,12}$/.test(q.get('photo') ?? '');
const error = errorText(q.get('e'));
const liveUrl = draft?.slug ? `${siteUrl()}/stories/${draft.slug}/` : '';
const isAgent = draft?.source === 'agent';
const libraryModules = [
  ['text','Paragraph','writing'],['heading','Heading','writing'],['quote','Quote','writing'],['list','List','writing'],
  ['image','Image','media'],['gallery','Gallery','media'],['flyer','Flyer','media'],['video','Video','media'],
  ['button','Button / link','actions'],['divider','Divider','layout'],['section','Section / columns','layout'],
];
// Administrators are reminded on the publish screen when backups are off: the database is the only copy of the stories.
const backupsOff = Astro.locals.user?.role === 'admin' && !driveConfig().configured;
// Only an http(s) address becomes a link (the API checks it too; this is the last line of defence).
const originalPost = draft?.sourceUrl && /^https?:\/\//i.test(draft.sourceUrl) ? draft.sourceUrl : '';
const hasSubmitter = !!draft && !isAgent && (draft.source !== 'editor' || !!(draft.submitterName || draft.submitterEmail || draft.submitterPhone || draft.submitterChurch));
// Scheduled publishing (issue #124): every time is shown and entered in America/Chicago, never the viewer's own zone.
const scheduledAt = draft && editable ? draft.publishAt : null;
const suggestionAt = draft && editable ? draft.suggestedPublishAt : null;
const suggestionUsable = suggestionAt !== null && suggestionAt > Date.now();
const studioBlocked = !!draft && draft.studioOverwroteAt !== null;
const scheduleStopped = !!draft && draft.publishFailCount >= MAX_FAILURES;
const safeImg = (u: string) => /^\/(images|media)\/[A-Za-z0-9._\-/]+$/.test(u) || /^https:\/\//.test(u);
const sectionKnown = !!draft && SECTIONS.some((s) => s.key === draft.section);
const eyebrow = draft && sectionKnown ? sectionLabel(draft.section, draft.area) : '';
const hasBody = !!draft && !!draft.body.trim();
const isModular = !!draft?.storyBlocks?.length;
// Problems the editor already knows about (the rules publishing enforces, plus photo descriptions and inline photo markers), shown as links to the part that fixes them.
const problems: { text: string; panel: string; href: string; key?: string }[] = [];
if (draft && editable) {
  if (!draft.title.trim()) problems.push({ text: 'Headline is missing', panel: 'details', href: '#f-title', key: 'title' });
  if (!draft.author.trim()) problems.push({ text: 'Author is missing', panel: 'settings', href: '#f-author', key: 'author' });
  if (!sectionKnown) problems.push({ text: 'Choose a section', panel: 'settings', href: '#f-section', key: 'section' });
  if (!draft.date) problems.push({ text: 'Date is missing', panel: 'settings', href: '#f-date', key: 'date' });
  if (!hasBody) problems.push({ text: 'Story text is missing', panel: 'content', href: '#story-builder', key: 'body' });
  const noAlt = photos.filter((p) => !p.alt.trim()).length;
  if (noAlt) problems.push({ text: `${noAlt} ${noAlt === 1 ? 'photo has' : 'photos have'} no description`, panel: 'photos', href: '#photos' });
  // Only a live marker counts: lines in code blocks, escaped examples and the like are left out, exactly as the renderer treats them.
  const badMarkers = isModular ? 0 : [...paragraphLines(draft.body).values()].filter((line) => isMediaMarkerLine(line) && !parsePhotoMarker(line.trim(), photos.length) && !galleryMarker(line.trim(), photos.length)).length;
  if (badMarkers) problems.push({ text: `${badMarkers} photo ${badMarkers === 1 ? 'marker does' : 'markers do'} not match a photo`, panel: 'content', href: '#story-builder' });
}
// The five fixed problems are always rendered (hidden while fine), so clearing a field shows its problem again without a reload.
const KEYED = [
  { key: 'title', text: 'Headline is missing', panel: 'details', href: '#f-title' },
  { key: 'author', text: 'Author is missing', panel: 'settings', href: '#f-author' },
  { key: 'section', text: 'Choose a section', panel: 'settings', href: '#f-section' },
  { key: 'date', text: 'Date is missing', panel: 'settings', href: '#f-date' },
  { key: 'body', text: 'Story text is missing', panel: 'content', href: '#story-builder' },
];
const hasNotes = !!draft && (isAgent || !!draft.agentNote || hasSubmitter);
// The compact line under the headline (kept in step by the page script as the Story settings change).
const detailsLine = draft ? ([sectionKnown ? eyebrow : '', draft.author, draft.date, draft.church].filter(Boolean).join(' · ') || 'Section, author and date are set in Story settings.') : '';
const keyPointCount = draft ? (draft.keyPoints ?? []).filter((k) => k.trim()).length : 0;
const layoutLabel = draft ? PHOTO_LAYOUTS.find((l) => l.value === draft.photoLayout)?.label ?? '' : '';
const wordCount = draft ? (draft.body.trim() ? draft.body.trim().split(/\s+/).length : 0) : 0;
// One-line summaries shown on a collapsed step card (kept in step by the page script).
const detailsSummary = draft ? [draft.title.trim() || 'No headline yet', keyPointCount ? `${keyPointCount} key ${keyPointCount === 1 ? 'point' : 'points'}` : ''].filter(Boolean).join(' · ') : '';
const photosSummary = draft ? (photos.length ? `${photos.length} ${photos.length === 1 ? 'photo' : 'photos'} · ${layoutLabel}` : 'No photos yet') : '';
const storySummary = draft ? (isModular ? `${countStoryBlocks(draft.storyBlocks ?? [])} ${countStoryBlocks(draft.storyBlocks ?? []) === 1 ? 'module' : 'modules'}` : hasBody ? `Markdown · ${wordCount} ${wordCount === 1 ? 'word' : 'words'}` : 'No text yet') : '';
const libraryGroups: [string, string][] = [['writing', 'Writing'], ['media', 'Images & video'], ['layout', 'Layout & structure'], ['actions', 'Links & buttons']];
const notesTitle = isAgent ? 'AI agent' : 'Submitter & notes';
const chipText = !draft ? '' : draft.status === 'published' ? 'Published' : draft.status === 'rejected' ? 'Rejected' : scheduledAt !== null ? `Scheduled for ${fmtChicago(scheduledAt)}` : draft.status === 'new' ? 'New' : 'In review · saved';
---
<Admin title={draft ? draft.title || 'Untitled story' : 'Draft not found'} current={draft?.announcement?.kind === 'event' ? 'events' : draft?.announcement ? 'announcements' : 'drafts'} wide compact>
  {!draft ? (
    <>
      <h1>Draft not found</h1>
      <p class="admin-note"><a href="/admin">Back to the drafts</a></p>
    </>
  ) : (
    <div class="ed editor-studio" data-draft={draft.id} data-side="right">
      <header class="ed-bar" id="ed-bar">
        <a class="studio-back ed-back" href={draft.announcement?.kind === 'event' ? '/admin/events' : draft.announcement ? '/admin/announcements' : '/admin'}>← {draft.announcement?.kind === 'event' ? 'Events' : draft.announcement ? 'Announcements' : 'Stories'}</a>
        <div class="ed-title">
          <h1 class="ed-headline" title={draft.title || 'Untitled story'}>{draft.title || 'Untitled story'}</h1>
          <p class="ed-subline">
          <span class={`ed-chip ${draft.status === 'published' ? 'ok' : draft.status === 'rejected' ? 'bad' : scheduledAt !== null ? 'ok' : 'warn'}`} data-editor-chip>{chipText}</span>
          {isAgent && <span class="ed-chip">From AI agent</span>}
          <span class="ed-live">{draft.live ? 'Live' : 'Not live · draft only'}</span><span class="ed-status" id="save-status" role="status" aria-live="polite">
            {draft.updatedByName ? <>Last saved <time datetime={new Date(draft.updatedAt).toISOString()} data-local>{fmtTime(draft.updatedAt)}</time> by {draft.updatedByName}</> : <>Last saved <time datetime={new Date(draft.updatedAt).toISOString()} data-local>{fmtTime(draft.updatedAt)}</time></>}
          </span></p>
        </div>
        <nav class="ed-nav" aria-label="Editor sections">
          <a href="#ed-canvas" aria-current="true" data-editor-nav="editor">Editor</a>
          <a href="#studio-panel-settings" data-open-panel="settings" data-editor-nav="settings">Story settings</a>
          {editable && <a href="#studio-panel-review" data-open-panel="review" data-editor-nav="review">Publishing</a>}
        </nav>
        <span class="ed-bar-actions">
          <span class="ed-undo" role="group" aria-label="Module history" hidden={!isModular}>
            <button class="ed-icon-btn" type="button" id="blocks-undo" aria-label="Undo module change" title="Undo module change" disabled><span aria-hidden="true">↶</span></button>
            <button class="ed-icon-btn" type="button" id="blocks-redo" aria-label="Redo module change" title="Redo module change" disabled><span aria-hidden="true">↷</span></button>
          </span>
          <button type="button" class="ed-btn" data-studio-preview data-js-only>Preview</button>
          <button type="submit" form="draft-form" class="ed-btn outline" id="save-btn" disabled={!editable}>Save changes</button>
          {editable && <a class="ed-btn primary ed-publish" href="#publish-form" data-open-panel="review">Publish</a>}
          <button type="button" class="ed-icon-btn" id="ed-layout-button" aria-label="Layout options" aria-expanded="false" aria-controls="ed-layout-menu" data-js-only><span aria-hidden="true">⋮</span></button>
        </span>
      </header>
      <div class="ed-layout-menu" id="ed-layout-menu" role="group" aria-label="Layout options" hidden>
        <button type="button" class="ed-btn" data-layout-action="toggle">Hide sidebar</button>
        <button type="button" class="ed-btn" data-layout-action="side">Move sidebar to the left</button>
        <button type="button" class="ed-btn" data-layout-action="narrower">Sidebar narrower</button>
        <button type="button" class="ed-btn" data-layout-action="wider">Sidebar wider</button>
        <button type="button" class="ed-btn" data-layout-action="reset">Reset layout</button>
        <p class="ed-hint">You can also drag the sidebar's edge, or focus it and use the arrow keys. Your layout is remembered in this browser.</p>
      </div>
      <div class="studio-mobile-actions" role="group" aria-label="Story actions">
        <button type="submit" form="draft-form" class="cms-btn" id="mobile-save-btn" aria-describedby="save-status" disabled={!editable}>Save changes</button>
        {editable && <button type="button" class="cms-btn studio-review-action" data-open-panel="review">Review &amp; publish</button>}
        <span data-mobile-save-status aria-hidden="true"></span>
      </div>

      {published && (
        <p class="admin-ok" role="status">
          Published. It's live now at <a href={liveUrl}>{liveUrl}</a>.
        </p>
      )}
      {notice && !published && <p class="admin-ok" role="status">{notice}</p>}
      {error && <p class="admin-error" role="alert">{error}</p>}
      {Astro.url.searchParams.get('revision_restored') === '1' && <p role="status" class="admin-ok" id="revision-restored">Saved revision restored to this draft. Review it before publishing.</p>}
      {Astro.url.searchParams.get('missing_media') === '1' && <p role="alert" class="admin-error" id="revision-missing-media">Some older photos are no longer available. Missing module references were removed; review inline markers and the first photo or flyer before publishing.</p>}
      {Astro.url.searchParams.get('photo_replaced_kept') === '1' && <p role="status" class="admin-ok" id="revision-replaced-kept">A photo was replaced after that saved version. The newer photo file was kept in its place, with the older alt text, caption and crop.</p>}
      {draft.studioOverwroteAt && (draft.status === 'new' || draft.status === 'in_review') && (
        <p class="admin-error" role="status">IMConnected Studio published over this story on <time datetime={new Date(draft.studioOverwroteAt).toISOString()} data-local>{fmtTime(draft.studioOverwroteAt)}</time>; your saved edits here are not live.</p>
      )}
      <p id="conflict" class="admin-error" role="alert" hidden>Someone else changed this draft, so your changes were not saved. <a href={`/admin/drafts/${draft.id}`}>Reload to see their changes</a>.</p>

      {draft.status === 'published' && (
        <section class="ed-card ed-closed">
          <h2>Published</h2>
          <p>
            This story is live{draft.publishedAt ? <> since <time datetime={new Date(draft.publishedAt).toISOString()} data-local>{fmtTime(draft.publishedAt)}</time></> : null}{draft.publishedByName ? ` (published by ${draft.publishedByName})` : ''}.
            {liveUrl && <> <a href={liveUrl}>View it on the site</a>.</>}
          </p>
          <form method="post" action="/api/admin/stories/edit">
            <input type="hidden" name="slug" value={draft.slug ?? ''} />
            <button class="cms-btn" type="submit">Edit this story</button>
          </form>
        </section>
      )}

      {draft.status === 'rejected' && (
        <section class="ed-card ed-closed">
          <h2>Rejected</h2>
          {draft.rejectNote && <p><strong>Note:</strong> {draft.rejectNote}</p>}
          <p class="admin-note">Photos are kept for 30 days after rejection, then deleted.</p>
          <form method="post" action={`/api/admin/drafts/${draft.id}/restore`} id="restore-form">
            <input type="hidden" name="version" value={draft.updatedAt} />
            <button class="cms-btn" type="submit">Restore to In review</button>
          </form>
        </section>
      )}
      <div class="ed-body" id="ed-body">
        <div class="ed-canvas" id="ed-canvas" tabindex="-1">
          <form id="draft-form" method="post" action={`/api/admin/drafts/${draft.id}/save`} data-save={`/api/admin/drafts/${draft.id}/save`} data-preview={`/api/admin/drafts/${draft.id}/preview`} data-revisions={`/api/admin/drafts/${draft.id}/revisions`}>
            <input type="hidden" name="version" value={draft.updatedAt} />
            <fieldset disabled={!editable} class="ed ed-canvas-fields">
              <section class="ed-card ed-step" id="ed-details" aria-labelledby="ed-details-heading" data-card-group data-group="details">
                <div class="ed-card-head">
                  <h2 id="ed-details-heading"><span class="ed-badge" aria-hidden="true">1</span> Story details</h2>
                  <span class="ed-card-summary" data-card-summary="details">{detailsSummary}</span>
                  <button type="button" class="ed-card-toggle" data-card-toggle data-js-only aria-expanded="true" aria-controls="ed-details-body" data-label="Story details"><span class="sr-only">Collapse Story details</span></button>
                </div>
                <div class="ed-group-body" id="ed-details-body" data-card-body>
                <div class="ed-grid">
              <label class="full ed-big">Title <span class="hint">up to {LIMITS.title} characters</span>
                <input type="text" id="f-title" name="title" value={draft.title} maxlength={LIMITS.title} autocomplete="off" />
              </label>
              <label class="full ed-big">Summary (dek) <span class="hint">one or two sentences, up to {LIMITS.dek} characters</span>
                <input type="text" name="dek" value={draft.dek} maxlength={LIMITS.dek} autocomplete="off" />
              </label>
                </div>
                <p class="ed-summary-line" data-details-line><span data-details-text>{detailsLine}</span> <a href="#studio-panel-settings" data-open-panel="settings">Edit details</a></p>
              <details class="ed-group ed-keypoints-group" data-group="keypoints" data-group-default="closed" data-group-auto-open={keyPointCount > 0 || q.get('e') === 'save_invalid' ? 'true' : undefined} open>
              <summary class="ed-group-summary"><span>Key points (<span data-kp-count>{keyPointCount}</span>)</span></summary>
              <div class="ed-group-body">
              <fieldset class="ed-key-points"><legend>Key points <span class="hint">optional, up to 3 short lines of plain text (160 characters each); shown in a box above the story</span></legend>
                <input type="hidden" name="keyPointsPresent" value="1" />
                {[0, 1, 2].map((i) => <label>Key point {i + 1}<input type="text" name={`keyPoint${i}`} value={draft.keyPoints?.[i] ?? ''} maxlength="160" autocomplete="off" /></label>)}
              </fieldset>
              </div>
              </details>
                </div>
              </section>

              <section class="ed-card ed-step" id="photos" aria-labelledby="ed-photos-heading" data-card-group data-group="photos">
                <div class="ed-card-head">
                  <h2 id="ed-photos-heading"><span class="ed-badge" aria-hidden="true">2</span> Photos</h2>
                  <span class="ed-card-summary" data-card-summary="photos">{photosSummary}</span>
                  <button type="button" class="ed-card-toggle" data-card-toggle data-js-only aria-expanded="true" aria-controls="ed-photos-body" data-label="Photos"><span class="sr-only">Collapse Photos</span></button>
                </div>
                <div class="ed-group-body" id="ed-photos-body" data-card-body>
            <p class="admin-note">The first photo leads the story. JPG, PNG, WebP or AVIF, up to {LIMITS.maxPhotoMB} MB each, up to {LIMITS.maxPhotos} photos.</p>
            {photos.length > 0 && (
              <p class="admin-note" id="photo-reorder-help">Reorder: use Up and Down on any device or keyboard. With a mouse or touch, drag a photo by its Drag handle onto a new place. Inline photo markers follow their photos.</p>
              <p class="sr-only" role="status" aria-live="polite" id="photo-reorder-live" data-announce={photoNotice ? notice : undefined}></p>
              <ol class="ed-photos" aria-describedby="photo-reorder-help">
                {photos.map((p, i) => (
                  <li class="ed-photo" data-photo-item={p.id} data-photo-id={p.id}>
                    <div class="ed-photo-thumb">
                      {(p.path || p.url && safeImg(p.url)) ? <img src={p.path ? `/api/admin/photos/${p.id}` : p.url!} alt="" draggable="false" referrerpolicy="no-referrer" loading="lazy" data-photo-thumb={p.id} style={`object-position:${p.focalX ?? 50}% ${p.focalY ?? 50}%`} /> : <span class="ed-photo-nothumb" aria-hidden="true">No preview</span>}
                      <span class="ed-photo-noalt" data-photo-noalt={p.id} hidden={!!p.alt.trim()}>No description</span>
                      <strong class="ed-photo-label">{i === 0 ? 'Lead photo' : `Photo ${i + 1}`}</strong>
                    </div>
                    <div class="ops ed-photo-move">
                      {editable && photos.length > 1 && <span class="ph-handle" data-photo-handle={p.id} hidden title="Drag to reorder" aria-hidden="true">⋮⋮ Drag</span>}
                      <button type="submit" form="photo-form" name="op" value={`up:${p.id}`} disabled={i === 0} aria-label={`Move photo ${i + 1} up`}>Up</button>
                      <button type="submit" form="photo-form" name="op" value={`down:${p.id}`} disabled={i === photos.length - 1} aria-label={`Move photo ${i + 1} down`}>Down</button>
                    </div>
                    <details class="ed-group ed-photo-more" data-group={`photo-${p.id}`} data-group-persist="false" data-group-default="closed" open>
                      <summary class="ed-group-summary"><span>Details<span class="sr-only"> for photo {i + 1}: caption, description, crop and replace</span></span></summary>
                      <div class="ed-group-body ed-photo-body">
                    <div class="sb-photo-preview"><span class="sb-crop-label">Reader crop preview</span>{(p.path || p.url && safeImg(p.url)) ? <div class="sb-pan-crop" data-pan-photo={p.id} tabindex={editable && p.fit !== 'contain' ? 0 : -1} aria-disabled={p.fit === 'contain' ? 'true' : undefined} {...(photoFrameAttrs(p, p.path ? `/api/admin/photos/${p.id}` : p.url!) ?? {})} role="group" aria-label={`Pan crop for photo ${i + 1}. Drag the image or use arrow keys. Shift moves ten percent.`}><img data-focus-preview={p.id} src={p.path ? `/api/admin/photos/${p.id}` : p.url!} alt="" draggable="false" style={photoFocusStyle({ ...p, fit: 'cover' })} referrerpolicy="no-referrer" /></div> : <div></div>}<p class="admin-note" data-pan-note={p.id}>{p.fit === 'contain' ? 'The whole photo is shown, so there is nothing to pan.' : 'Drag the crop to move the image. Arrow keys pan; Shift moves faster.'}</p></div>
                    <div class="fields">
                      <label>Alt text (describe the photo for readers who can't see it)
                        <input type="text" name={`photo_${p.id}_alt`} value={p.alt} maxlength="300" autocomplete="off" />
                      </label>
                      <label>Caption (shown under the photo, optional)
                        <input type="text" name={`photo_${p.id}_caption`} value={p.caption} maxlength="300" autocomplete="off" aria-describedby={`caption-help-${p.id}`} data-photo-caption={p.id} />
                      </label>
                      <p class="admin-note" id={`caption-help-${p.id}`}>Alt text describes the picture for readers who can't see it. The caption is visible to everyone, as plain text up to 300 characters. Don't repeat the alt text here.</p>
                      {(p.path || p.url && safeImg(p.url)) && <details class="sb-focus-settings" open={i === 0}><summary>Adjust image focus</summary>
                        <div class="sb-fit" data-fit-group={p.id}>
                          <input type="hidden" name={`photo_${p.id}_fit`} value="cover" />
                          <label class="sb-fit-toggle"><input type="checkbox" name={`photo_${p.id}_fit`} value="contain" checked={p.fit === 'contain'} data-fit-toggle={p.id} aria-describedby={`fit-help-${p.id}`} /> <span>Fit whole photo</span></label>
                          <p class="admin-note" id={`fit-help-${p.id}`}>Show the entire photo instead of cropping it. Zoom and pan are turned off while this is on.</p>
                          <fieldset class="sb-fit-fill" data-fit-fill-group={p.id} disabled={p.fit !== 'contain'}>
                            <legend>Fill behind the photo</legend>
                            <label><input type="radio" name={`photo_${p.id}_fitFill`} value="blur" checked={p.fitFill === 'blur'} /> <span>Blurred photo</span></label>
                            <label><input type="radio" name={`photo_${p.id}_fitFill`} value="paper" checked={p.fitFill === 'paper'} /> <span>Page color</span></label>
                            <label><input type="radio" name={`photo_${p.id}_fitFill`} value="navy" checked={p.fitFill === 'navy'} /> <span>Navy</span></label>
                          </fieldset>
                        </div>
                        <p class="admin-note">Drag the marker to the subject. Arrow keys move it; Shift + arrow moves 10%. The original image stays unchanged.</p>
                        <div class="sb-focal" tabindex={editable && p.fit !== 'contain' ? 0 : -1} aria-disabled={p.fit === 'contain' ? 'true' : undefined} role="group" aria-label={`Focal point for photo ${i + 1}. Use arrow keys to adjust.`} data-focal={p.id}>
                          <img src={p.path ? `/api/admin/photos/${p.id}` : p.url!} alt={p.alt || `Photo ${i + 1}`} draggable="false" referrerpolicy="no-referrer" />
                          <span class="sb-focal-marker" aria-hidden="true" style={`left:${p.focalX ?? 50}%;top:${p.focalY ?? 50}%`}></span>
                        </div>
                        <div class="sb-focal-values">
                          <label>Horizontal focus<input type="range" min="0" max="100" step="any" name={`photo_${p.id}_focalX`} value={p.focalX ?? 50} disabled={p.fit === 'contain'} aria-label={`Photo ${i + 1} horizontal focus`} /></label>
                          <label>Vertical focus<input type="range" min="0" max="100" step="any" name={`photo_${p.id}_focalY`} value={p.focalY ?? 50} disabled={p.fit === 'contain'} aria-label={`Photo ${i + 1} vertical focus`} /></label>
                          <button type="button" data-center-focus={p.id} disabled={p.fit === 'contain'}>Center focus</button>
                        </div>
                        <div class="sb-zoom-controls">
                          <label>Zoom <output data-zoom-output={p.id}>{Math.round(p.zoom * 100)}%</output><input type="range" min="1" max="3" step="0.01" name={`photo_${p.id}_zoom`} value={p.zoom} disabled={p.fit === 'contain'} aria-valuetext={`${Math.round(p.zoom * 100)} percent`} aria-label={`Photo ${i + 1} zoom`} /></label>
                          <div><button type="button" data-zoom-photo={p.id} data-zoom-step="-0.1" disabled={p.fit === 'contain'} aria-label={`Zoom photo ${i + 1} out`}>−</button><button type="button" data-zoom-photo={p.id} data-zoom-step="0.1" disabled={p.fit === 'contain'} aria-label={`Zoom photo ${i + 1} in`}>+</button><button type="button" data-reset-crop={p.id} disabled={p.fit === 'contain'}>Reset crop</button></div>
                        </div>
                        <output data-focus-output={p.id} aria-live="polite">{p.focalX ?? 50}% horizontal, {p.focalY ?? 50}% vertical</output>
                      </details>}
                    </div>
                    <div class="ops">
                      {i > 0 && <button type="submit" form="photo-form" name="op" value={`lead:${p.id}`}>Make lead</button>}
                      <button type="submit" form="photo-form" name="op" value={`delete:${p.id}`} class="del" aria-label={`Delete photo ${i + 1}`}>Delete</button>
                      {editable && <details class="ph-replace"><summary>Replace photo</summary>
                        <label>New file for photo {i + 1}<input type="file" name={`replacement_${p.id}`} form="photo-form" accept="image/jpeg,image/png,image/webp,image/avif" /></label>
                        <p class="admin-note">Keeps this photo's alt text, caption, crop and place in the story.</p>
                        <button type="submit" form="photo-form" name="op" value={`replace:${p.id}`} aria-label={`Replace photo ${i + 1} with the chosen file`}>Replace</button>
                      </details>}
                    </div>
                      </div>
                    </details>
                  </li>
                ))}
              </ol>
            )}
            {photos.length < LIMITS.maxPhotos && (
              <div class="ed-field sb-upload-zone">
                <label for="f-upload">Add photos to this story</label><p>Upload once, then use a photo in any Image module or gallery layout.</p>
                <input id="f-upload" type="file" name="photos" form="photo-form" accept="image/jpeg,image/png,image/webp,image/avif" multiple />
                <div><button type="submit" form="photo-form" name="op" value="upload" class="cms-btn secondary">Upload</button></div>
              </div>
            )}
            <details class="ed-group" data-group="photo-layout" data-group-default="closed" open>
              <summary class="ed-group-summary"><span>Photo layout: <span data-layout-name>{layoutLabel}</span></span></summary>
              <div class="ed-group-body">
            <fieldset class="ed-layouts">
              <legend>Photo layout</legend>
              <p class="admin-note">How the photos are arranged on the story page. A layout with more places than photos simply uses what there is: with one photo every layout looks like “One hero”.</p>
              <div class="ed-layout-cards">
                {PHOTO_LAYOUTS.map((l) => (
                  <label class="ed-layout">
                    <input type="radio" name="photoLayout" value={l.value} checked={l.value === draft.photoLayout} />
                    <span class={`lay-mini lay-${l.value}`} aria-hidden="true">
                      {Array.from({ length: { one: 1, twoUp: 2, heroGrid: 3, mosaic: 4, stack: 3, carousel: 3, threeUp: 3 }[l.value] }, () => <i></i>)}
                    </span>
                    <span class="lay-name">{l.label}</span>
                    <span class="lay-hint">{l.hint}</span>
                  </label>
                ))}
              </div>
            </fieldset>
              </div>
            </details>
                </div>
              </section>

              <section class="ed-card ed-step story-builder" id="story-builder" aria-labelledby="ed-story-heading" data-card-group data-group="story">
                <div class="ed-card-head">
                  <h2 id="ed-story-heading"><span class="ed-badge" aria-hidden="true">3</span> Story</h2>
                  <span class="ed-card-summary" data-card-summary="story">{storySummary}</span>
                  <button type="button" class="ed-card-toggle" data-card-toggle data-js-only aria-expanded="true" aria-controls="ed-story-body" data-label="Story"><span class="sr-only">Collapse Story</span></button>
                </div>
                <div class="ed-group-body" id="ed-story-body" data-card-body>
            {draft.body.includes('<') && (
              <p class="admin-error" role="alert">This text contains “&lt;”, so it may hold raw HTML. Raw HTML is not kept: after you publish, it is shown to readers as plain text. Rewrite it in Markdown if you need the formatting.</p>
            )}
                <input type="hidden" name="storyBlocks" id="story-blocks" value={JSON.stringify(draft.storyBlocks ?? [])} />
                <div class="ed-split" id="split" data-mode={isModular ? 'modules' : 'markdown'}>
                  <div id="module-canvas" class="ed-module-canvas" hidden={!isModular}>
                    <p class="sb-drag-help" data-js-only>Select a module to edit it in the sidebar. Drag to reorder; the Move buttons also work with a keyboard. <span class="sb-count"><span id="module-count"></span> modules</span></p>
                    <ol id="module-outline" aria-label="Story modules"></ol>
                  </div>
                  <div id="markdown-workspace">
                    <div class="ed-markdown-head"><span class="ed-eyebrow">Body text</span><button type="button" class="ed-btn" data-split-modules data-js-only>Split into modules</button></div>
                    <div class="ed-toolbar" role="toolbar" aria-label="Formatting">
                  <button type="button" data-md="bold" aria-label="Bold"><strong>B</strong></button>
                  <button type="button" data-md="italic" aria-label="Italic"><em>I</em></button>
                  <button type="button" data-md="heading" aria-label="Heading">H</button>
                  <button type="button" data-md="quote" aria-label="Quote">“ ”</button>
                  <button type="button" data-md="link" aria-label="Link">Link</button>
                  <button type="button" data-md="list" aria-label="List">• List</button>
                  <label>Story photo<select id="inline-photo-choice" data-editor-local aria-label="Story photo to insert"><option value="">Choose a photo</option>{photos.map((p, i) => <option value={i + 1}>Photo {i + 1}{p.alt ? ` — ${p.alt}` : ''}</option>)}</select></label>
                  <label>Size and alignment<select id="inline-photo-placement" data-editor-local disabled={photos.length === 0} aria-label="Size and alignment of the inserted photo"><option value="">Column width</option><option value="wide">Wide</option><option value="full">Full width</option><option value="left">Left, text wraps</option><option value="right">Right, text wraps</option></select></label>
                  <button type="button" id="insert-inline-photo" disabled={!photos.length}>Insert photo</button>
                </div>
                <div class="ed-toolbar" role="group" aria-label="Insert photo gallery">
                  <label>From photo<select id="gallery-photo-start" data-editor-local>{photos.map((p, i) => <option value={i + 1}>Photo {i + 1}</option>)}</select></label>
                  <label>To photo<select id="gallery-photo-end" data-editor-local>{photos.map((p, i) => <option value={i + 1} selected={i === photos.length - 1}>Photo {i + 1}</option>)}</select></label>
                  <label>Gallery columns<select id="gallery-columns" data-editor-local><option value="2">2 columns</option><option value="3">3 columns</option></select></label>
                  <button type="button" id="insert-inline-gallery" disabled={photos.length < 2}>Insert gallery</button>
                  <span id="gallery-marker-status" role="status"></span>
                </div>
                {draft.storyBlocks?.length ? <noscript><p class="admin-error">This story is built from modules, which need JavaScript to edit. Without it the text below is read-only.</p></noscript> : null}
                <textarea class="body" name="body" id="f-body" aria-label="Story text" readonly={!!draft.storyBlocks?.length}>{draft.body}</textarea>
                  </div>
                  <p id="module-status" class="admin-note" role="status" aria-live="polite"></p>
                </div>
                </div>
              </section>
            </fieldset>
          </form>
          <form id="photo-form" method="post" action={`/api/admin/drafts/${draft.id}/photos`} enctype="multipart/form-data">
            <input type="hidden" name="version" value={draft.updatedAt} />
          </form>
        </div>

        <aside class="ed-sidebar" id="ed-sidebar" aria-label="Story sidebar">
          <div class="ed-resize" id="ed-resize" role="separator" aria-controls="ed-sidebar" aria-orientation="vertical" aria-label="Resize sidebar" tabindex="0" hidden></div>
          <div class="ed-tablist" role="tablist" aria-label="Sidebar" hidden>
            <button type="button" role="tab" class="ed-tab" id="studio-tab-modules" data-studio-tab="modules" aria-controls="studio-panel-modules" aria-selected="true" hidden={!editable}>Modules</button>
            <button type="button" role="tab" class="ed-tab" id="studio-tab-module" data-studio-tab="module" aria-controls="studio-panel-module" aria-selected="false" tabindex="-1" hidden={!isModular} aria-label="Module settings">Module</button>
            <button type="button" role="tab" class="ed-tab" id="studio-tab-settings" data-studio-tab="settings" aria-controls="studio-panel-settings" aria-selected="false" tabindex="-1" aria-label="Settings for the story">Settings</button>
            {editable && <button type="button" role="tab" class="ed-tab" id="studio-tab-review" data-studio-tab="review" aria-controls="studio-panel-review" aria-selected="false" tabindex="-1">Publish</button>}
            {editable && <button type="button" role="tab" class="ed-tab" id="studio-tab-history" data-studio-tab="history" aria-controls="studio-panel-history" aria-selected="false" tabindex="-1">History</button>}
          </div>

          <section class="ed-tabpanel story-builder" role="tabpanel" id="studio-panel-modules" data-studio-panel="modules" aria-labelledby="studio-tab-modules" data-js-only>
            <h2 class="ed-panel-title">Modules</h2>
            <fieldset disabled={!editable} class="ed-flat">
              <div id="markdown-split" class="ed-split-note" hidden={isModular}>
                <p class="admin-note">This story is written as Markdown text. Split it into modules to edit it in parts, add images, columns, buttons and more. Your text is kept, and you can undo this change.</p>
                <button class="ed-btn" type="button" id="use-modules" title="Split the Markdown text into one paragraph module per block of text. You can undo this.">Split into modules</button>
              </div>
              <div id="module-workspace" class="sb-modules" hidden={!isModular}>
                <div class="sb-library-disclosure">
                    <label class="sb-library-search" for="module-library-search">Find a module<input type="search" id="module-library-search" placeholder="Try heading or image" autocomplete="off" aria-describedby="module-library-results" /></label>
                    <p class="sb-insert-help">Click to add after the selected module.</p>
                    <div class="sb-library-feedback"><span id="module-library-results" role="status" aria-live="polite">11 modules</span><button type="button" id="module-library-reset" hidden>Clear search</button></div>
                    <p id="module-library-empty" class="admin-note" hidden>No modules match. Clear the search to see all modules.</p>
                    <div class="sb-library-groups">
                      {libraryGroups.map(([key, title], index) => (
                        <details class="ed-group" data-group={key} data-library-group={key} data-group-default={index === 0 ? 'open' : 'closed'} open>
                          <summary class="ed-group-summary"><span>{title}</span></summary>
                          <div class="ed-group-body sb-library" role="group" aria-label={title}>
                            {libraryModules.filter((m) => m[2] === key).map(([type,label,category]) => <button type="button" data-add-module={type} data-library-category={category} data-library-item={type}>{label}</button>)}
                          </div>
                        </details>
                      ))}
                      <details class="ed-group" data-group="starters" data-group-default="closed" open>
                        <summary class="ed-group-summary"><span>Starter layouts</span></summary>
                        <div class="ed-group-body">
                          <p class="sb-insert-help">Add an empty structure, then write your own story.</p>
                          <div class="sb-starters" role="group" aria-label="Insert starter layout after selected module">
                            <button type="button" data-insert-layout="news">News story <small>Paragraph · heading · paragraph · quote</small></button>
                            <button type="button" data-insert-layout="recap">Event recap <small>Heading · paragraph · list · paragraph</small></button>
                            <button type="button" data-insert-layout="announcement">Announcement <small>Heading · paragraph · list · divider</small></button>
                          </div>
                        </div>
                      </details>
                      <details class="ed-group" data-group="saved" data-group-default="closed" open>
                        <summary class="ed-group-summary"><span>My saved layouts</span></summary>
                        <div class="ed-group-body">
                          <p class="admin-note">Save the structure and settings. Text, links and photo choices are left out.</p>
                          <label>Layout name<input id="saved-layout-name" data-editor-local maxlength="80" autocomplete="off" /></label>
                          <button type="button" id="save-story-layout">Save this structure</button>
                          <label>Saved layout<select id="saved-layout-choice" aria-label="Saved layout" data-editor-local><option value="">Loading layouts…</option></select></label>
                          <div class="sb-controls"><button type="button" id="insert-story-layout">Insert saved layout</button><button type="button" id="delete-story-layout">Delete saved layout</button></div>
                          <p id="saved-layout-status" role="status" class="admin-note"></p>
                        </div>
                      </details>
                      <details class="ed-group" data-group="more" data-group-default="closed" open>
                        <summary class="ed-group-summary"><span>More</span></summary>
                        <div class="ed-group-body">
                          <button class="ed-btn" type="button" id="use-markdown">Use Markdown</button>
                          <label class="sb-library-category" for="module-library-category">Show only<select id="module-library-category"><option value="all">All modules</option><option value="favorites">My quick access</option><option value="writing">Writing</option><option value="media">Images &amp; video</option><option value="layout">Layout &amp; structure</option><option value="actions">Links &amp; buttons</option></select></label>
                          <details class="sb-library-preferences"><summary>Customize quick access</summary><p>Choose your go-to modules. Saved in this browser.</p>{libraryModules.map(([type,label]) => <label><input type="checkbox" data-pin-module={type} />{label}</label>)}<p id="module-pin-status" role="status"></p></details>
                        </div>
                      </details>
                    </div>
                </div>
              </div>
            </fieldset>
          </section>

          <section class="ed-tabpanel" role="tabpanel" id="studio-panel-module" data-studio-panel="module" aria-labelledby="studio-tab-module" data-js-only hidden={!isModular}>
            <fieldset disabled={!editable} class="ed-flat">
              <div class="sb-properties" id="module-inspector" aria-label="Selected module settings"><div class="sb-pane-heading"><div><h2 id="module-title" class="ed-panel-title">Module settings</h2><p>Make it your own</p></div></div><div id="module-fields"></div></div>
            </fieldset>
          </section>

          <section class="ed-tabpanel studio-settings" role="tabpanel" id="studio-panel-settings" data-studio-panel="settings" aria-labelledby="studio-tab-settings">
            <h2 class="ed-panel-title">Story settings</h2>
            <p class="admin-note">Where readers find this story, and who wrote it. <span class="studio-source">{isAgent ? 'From AI agent' : SOURCE_LABEL[draft.source]}</span></p>
            <fieldset disabled={!editable} class="ed-flat ed-groups">
              <details class="ed-group" data-group="placement" open>
                <summary class="ed-group-summary"><span>Section and placement</span></summary>
                <div class="ed-group-body"><div class="ed-grid ed-stack">
              <label>Section
                <select form="draft-form" name="section" id="f-section">
                  {!SECTIONS.some((s) => s.key === draft.section) && <option value="" selected>Choose a section</option>}
                  {SECTIONS.map((s) => <option value={s.key} selected={s.key === draft.section}>{s.label}</option>)}
                </select>
              </label>
              <fieldset class="full additional-sections"><legend>Additional sections</legend>
                <input form="draft-form" type="hidden" name="additionalSectionsPresent" value="1" />
                <p class="hint">Keep one primary section above. Add other sections where readers should also find this story; its category belongs to the primary section.</p>
                <div style="display:flex;flex-wrap:wrap;gap:12px 24px">{SECTIONS.map((s) => <label style="display:flex;align-items:center;gap:8px"><input form="draft-form" type="checkbox" name="additionalSections" value={s.key} checked={s.key === draft.section || draft.additionalSections?.includes(s.key)} disabled={s.key === draft.section} />{s.label}</label>)}</div>
              </fieldset>
              <label id="f-area-wrap">Category
                <select form="draft-form" name="area" id="f-area">
                  <option value="" data-section="" hidden={!!SECTIONS.find((s) => s.key === draft.section)?.areas}>None</option>
                  {SECTIONS.flatMap((s) => (s.areas ?? []).map((a) => (
                    <option value={a.key} data-section={s.key} selected={s.key === draft.section && a.key === draft.area} hidden={s.key !== draft.section}>{a.label}</option>
                  )))}
                </select>
              </label>
              <label>Content type
                <select form="draft-form" name="announcementKind"><option value="story" selected={!draft.announcement}>Story</option><option value="announcement" selected={draft.announcement?.kind === 'announcement'}>Announcement</option><option value="event" selected={draft.announcement?.kind === 'event'}>Event</option></select>
              </label>
              <label class="ed-check"><input form="draft-form" type="checkbox" name="featured" value="1" checked={draft.featured} /> Feature on the home page</label>
                </div></div>
              </details>
              <details class="ed-group" data-group="byline" data-group-default="closed" open>
                <summary class="ed-group-summary"><span>Byline and date</span></summary>
                <div class="ed-group-body"><div class="ed-grid ed-stack">
              <label>Author
                <input form="draft-form" type="text" id="f-author" name="author" value={draft.author} maxlength="120" autocomplete="off" />
              </label>
              <label>Author title
                <input form="draft-form" type="text" name="authorTitle" value={draft.authorTitle} maxlength="120" autocomplete="off" />
              </label>
              <label>Date
                <input form="draft-form" type="date" id="f-date" name="date" value={draft.date} />
              </label>
              <label>Photo credit
                <input form="draft-form" type="text" name="photoCredit" value={draft.photoCredit} maxlength="120" autocomplete="off" />
              </label>
                </div></div>
              </details>
              <details class="ed-group" data-group="church" data-group-default="closed" open>
                <summary class="ed-group-summary"><span>Church</span></summary>
                <div class="ed-group-body"><div class="ed-grid ed-stack">
              <label>Church
                <input form="draft-form" type="text" name="church" value={draft.church} maxlength="160" autocomplete="off" />
              </label>
                </div></div>
              </details>
              <details class="ed-group" data-group="announcement" data-group-default="closed" data-announcement-group open>
                <summary class="ed-group-summary"><span>Announcement</span></summary>
                <div class="ed-group-body"><div class="ed-grid ed-stack">
              <label>Event date <span class="hint">optional</span><input form="draft-form" type="date" name="eventDate" value={draft.announcement?.eventDate ?? ''} /></label>
              <label class="full">Event location <input form="draft-form" name="eventLocation" maxlength="200" value={draft.announcement?.location ?? ''} /></label>
              <label class="full">Announcement video <span class="hint">Paste a YouTube or Vimeo link; readers open it in a video popup.</span><input form="draft-form" name="announcementVideo" maxlength="2048" value={draft.announcement?.videoUrl ?? ''} /></label>
              <fieldset class="full"><legend>Announcement link buttons</legend><p class="admin-note">Choose Announcement or Event above. The first photo is its full-height flyer. Add a text summary so the flyer is also accessible.</p>
                {[0, 1, 2].map((i) => <div class="ed-grid"><label>Link {i + 1} label<input form="draft-form" name={`announcementLink${i}Label`} maxlength="120" value={draft.announcement?.links[i]?.label ?? ''} /></label><label>Link {i + 1} address<input form="draft-form" name={`announcementLink${i}Url`} maxlength="2048" value={draft.announcement?.links[i]?.url ?? ''} placeholder="https://" /></label></div>)}
              </fieldset>
                </div></div>
              </details>
              <details class="ed-group" data-group="newsletter" data-group-default="closed" open>
                <summary class="ed-group-summary"><span>Newsletter</span></summary>
                <div class="ed-group-body"><div class="ed-grid ed-stack">
              <label>Newsletter issue <span class="hint">where this story first appeared</span>
                <input form="draft-form" type="hidden" name="newsletterIssuePresent" value="1" />
                <select form="draft-form" name="newsletterIssue" id="f-newsletter-issue">
                  <option value="" selected={!draft.newsletterIssue}>None</option>
                  {issues.map((i) => <option value={i.number} selected={draft.newsletterIssue?.number === i.number}>Issue #{i.number} · {i.date}{i.title ? ` · ${i.title}` : ''}</option>)}
                </select>
              </label>
              <label>Position in the issue <span class="hint">1 to 999, optional</span>
                <input form="draft-form" type="number" name="newsletterPosition" min="1" max="999" step="1" inputmode="numeric" value={draft.newsletterIssue?.position ?? ''} />
              </label>
                </div></div>
              </details>
            </fieldset>
            {hasNotes && (
              <details class="ed-group studio-submitter-notes" id="studio-panel-notes" data-group="notes" data-group-default="closed" open>
                <summary class="ed-group-summary"><span>{notesTitle}</span></summary>
                <div class="ed-group-body">
                <p class="admin-note">Private. Editors only; never published.</p>
      {isAgent && (
        <section class="ed-card ed-sub">
          <h3>Submitter</h3>
          <dl>
            <dt>Name</dt><dd>AI agent</dd>
            {draft.agentNote && <><dt>Agent's note</dt><dd style="white-space:pre-wrap">{draft.agentNote}</dd></>}
            {originalPost && <><dt>Original post</dt><dd><a href={originalPost} rel="noopener noreferrer" target="_blank">View original post</a></dd></>}
          </dl>
          <p class="admin-note">An AI agent submitted this story or proposed updates. Check the facts, names and photos, and get permission where needed, before you publish.</p>
        </section>
      )}

      {!isAgent && draft.agentNote && (
        <section class="ed-card ed-sub">
          <h3>AI agent update</h3>
          <p class="admin-note">Review the proposed changes and photos before publishing.</p>
          <p style="white-space:pre-wrap">{draft.agentNote}</p>
        </section>
      )}

      {hasSubmitter && (
        <section class="ed-card ed-sub">
          <h3>Submitter</h3>
          <dl>
            <dt>Name</dt><dd>{draft.submitterName || '—'}</dd>
            <dt>Email</dt>
            <dd>
              {draft.submitterEmail ? (looksLikeEmail(draft.submitterEmail) ? <a href={`mailto:${draft.submitterEmail}`}>{draft.submitterEmail}</a> : draft.submitterEmail) : '—'}
              {draft.submitterEmail && (draft.emailVerified ? <span class="cms-badge ok"> Verified</span> : <span class="cms-badge warn"> Not verified</span>)}
            </dd>
            <dt>Phone</dt><dd>{draft.submitterPhone || '—'}</dd>
            <dt>Church</dt><dd>{draft.submitterChurch || '—'}</dd>
          </dl>
          <p class="admin-note">Contact details are for editors only and are never published.</p>
        </section>
      )}
                </div>
              </details>
            )}
          </section>

          {editable && (
            <section class="ed-tabpanel studio-review" role="tabpanel" id="studio-panel-review" data-studio-panel="review" aria-labelledby="studio-tab-review">
              <h2 class="ed-panel-title">Publishing</h2>
              <h3 class="ed-subtitle">Check before publishing</h3>
              <ul class="ed-problems" aria-label="Things to fix before publishing" hidden={problems.length === 0}>{KEYED.map((p) => <li data-problem={p.key} hidden={!problems.some((x) => x.key === p.key)}><a href={p.href} data-open-panel={p.panel}>{p.text}</a></li>)}{problems.filter((p) => !p.key).map((p) => <li><a href={p.href} data-open-panel={p.panel}>{p.text}</a></li>)}</ul>
              <p class="ed-ok" hidden={problems.length > 0}>No problems found.</p>
          <div class="studio-review-summary"><div><span>Story</span><strong data-review-title>{draft.title || 'Untitled story'}</strong></div><div><span>Author</span><strong data-review-author>{draft.author || 'Add an author in Story settings'}</strong></div><div><span>Content</span><strong data-review-content>{draft.storyBlocks?.length ? `${countStoryBlocks(draft.storyBlocks)} modules` : 'Markdown story'}</strong></div><div><span>Photos</span><strong>{photos.length} {photos.length === 1 ? 'photo' : 'photos'}</strong></div></div>
          <ul class="studio-review-checklist"><li>Check the headline, names and facts.</li><li>Confirm permission to use the story and photos.</li><li>Read the phone preview and describe your images with alt text.</li></ul>
          {backupsOff && <p class="admin-error" role="alert" id="backups-notice"><strong>Backups to Google Drive are not set up.</strong> Published stories now live only in this server's database, so there is no other copy. You can still publish. <a href="/admin/backups">See how to set up backups</a>.</p>}
          <p class="admin-note">
            {draft.live ? 'This story is already live. Publishing overwrites it with these changes. ' : ''}Publishing saves your changes, checks the story and puts it on the live site. It is live at once.
          </p>
          <form id="publish-form" method="post" action={`/api/admin/drafts/${draft.id}/publish`}>
            <input type="hidden" name="version" value={draft.updatedAt} />
            <button type="submit" class="cms-btn">{scheduledAt !== null ? 'Publish now' : draft.slug ? 'Publish changes' : 'Publish'}</button>
          </form>
          <details class="ed-group studio-schedule" id="studio-schedule" data-group="schedule" data-group-default="closed" data-group-auto-open={scheduledAt !== null || !!draft.publishError ? 'true' : undefined} open>
            <summary class="ed-group-summary"><span id="schedule-heading">Publish at a set time</span>{scheduledAt !== null && <span class="ed-group-note">Scheduled</span>}</summary>
            <div class="ed-group-body">
            {scheduledAt !== null ? (
              <>
                <p class="admin-ok" role="status" id="scheduled-for"><strong>Scheduled for <time datetime={new Date(scheduledAt).toISOString()}>{fmtChicago(scheduledAt)}</time>.</strong>{draft.publishAtByName ? ` Scheduled by ${draft.publishAtByName}.` : ''} The server publishes it then, at the version saved at that moment.</p>
                {draft.publishError && <p class="admin-error" role="alert" id="scheduled-failed"><strong>Scheduled publish failed.</strong> {errorTextFor(draft.publishError)} {STOP_AT_ONCE.has(draft.publishError) ? 'It was not retried. Schedule it again, or publish it now.' : scheduleStopped ? `It tried ${MAX_FAILURES} times and has stopped. Fix the problem and schedule it again, or publish it now.` : `Attempt ${draft.publishFailCount} of ${MAX_FAILURES}; it will try again shortly.`}</p>}
                <form id="unschedule-form" method="post" action={`/api/admin/drafts/${draft.id}/unschedule`}>
                  <input type="hidden" name="version" value={draft.updatedAt} />
                  <button type="submit" class="cms-btn secondary">Unschedule</button>
                </form>
              </>
            ) : <p class="admin-note">Choose a day and time and the server publishes this draft then. Times are Central Time (America/Chicago). You can unschedule it, or publish it now, until then.</p>}
            {suggestionAt !== null && (
              <div class="studio-suggestion" id="agent-suggestion">
                <p class="admin-note"><strong>AI agent suggests publishing at <time datetime={new Date(suggestionAt).toISOString()}>{fmtChicago(suggestionAt)}</time>.</strong> {suggestionUsable ? 'This is only a suggestion; nothing happens until you schedule it.' : 'That time has passed.'}</p>
                {suggestionUsable && !studioBlocked && suggestionAt !== scheduledAt && (
                  <form id="suggest-form" method="post" action={`/api/admin/drafts/${draft.id}/schedule`}>
                    <input type="hidden" name="version" value={draft.updatedAt} />
                    <input type="hidden" name="use_suggestion" value="1" />
                    <button type="submit" class="cms-btn secondary">Schedule for this time</button>
                  </form>
                )}
              </div>
            )}
            {studioBlocked && <p class="admin-error" role="status" id="schedule-studio-blocked">{errorTextFor('schedule_studio_overwrote')}</p>}
            {!studioBlocked && <form id="schedule-form" method="post" action={`/api/admin/drafts/${draft.id}/schedule`}>
              <input type="hidden" name="version" value={draft.updatedAt} />
              <label class="ed-field">Publish at (Central Time)
                <input type="datetime-local" name="publish_at" required value={scheduledAt !== null ? msToChicagoInput(scheduledAt) : ''} min={msToChicagoInput(Date.now())} data-editor-local />
              </label>
              <p><button type="submit" class="cms-btn secondary">{scheduledAt !== null ? 'Change time' : 'Schedule'}</button></p>
            </form>}
                      </div>
          </details>
          <details class="ed-group" id="reject-details" data-group="reject" data-group-default="closed" open>
            <summary class="ed-group-summary"><span>Reject this draft</span></summary>
            <div class="ed-group-body">
            <form id="reject-form" method="post" action={`/api/admin/drafts/${draft.id}/reject`}>
              <input type="hidden" name="version" value={draft.updatedAt} />
              <label class="ed-field">Internal note (optional, never published)
                <textarea name="note" maxlength="500"></textarea>
              </label>
              <p><button type="submit" class="cms-btn danger">Reject draft</button></p>
            </form>
            </div>
          </details>
            </section>
          )}

          {editable && (
            <section class="ed-tabpanel" role="tabpanel" id="studio-panel-history" data-studio-panel="history" aria-labelledby="studio-tab-history">
              <h2 class="ed-panel-title">History</h2>
              <p class="admin-note" data-meta="history">Saved versions</p>
          <div class="ed-history">
            <p class="admin-note">The latest 20 previous saved states are available. Restoring saves your current edits first and changes only this draft.</p>
            <label>Saved revision<select id="draft-revision-choice" data-editor-local aria-label="Saved revision"><option value="">Loading history…</option></select></label>
            <button type="button" class="cms-btn secondary" id="restore-draft-revision" disabled>Restore selected revision</button>
            <p id="draft-revision-status" role="status" class="admin-note"></p>
          </div>
            </section>
          )}
        </aside>
        <div class="ed-rail" id="ed-rail" hidden>
          <button type="button" class="ed-btn" data-layout-action="toggle">Show sidebar</button>
          {isModular && <button type="button" class="ed-btn" data-rail-add>Add module</button>}
        </div>
      </div>

      <dialog class="ed-dialog" id="ed-preview-dialog" aria-labelledby="ed-preview-title">
        <div class="ed-dialog-head">
          <h2 id="ed-preview-title">Draft preview</h2>
          <span class="ed-chip">{draft.live ? 'Live' : 'Not live'}</span>
          <div class="sb-preview-tools" role="group" aria-label="Preview width"><button type="button" data-preview-width="desktop" aria-pressed="true">Desktop</button><button type="button" data-preview-width="phone" aria-pressed="false">Phone</button></div>
          <button type="button" class="ed-btn" data-preview-close>Close preview</button>
        </div>
        <iframe id="preview" title="Story preview" sandbox="allow-same-origin" referrerpolicy="no-referrer"></iframe>
      </dialog>
    </div>
  )}
</Admin>

<script type="application/json" id="story-builder-data" set:html={JSON.stringify({ emptyStory: !draft?.body.trim() && !(draft?.storyBlocks?.length), photos: photos.map((p) => ({ id: p.id, src: p.path ? `/api/admin/photos/${p.id}` : p.url && safeImg(p.url) ? p.url : '', alt: p.alt, focalX: p.focalX ?? 50, focalY: p.focalY ?? 50, zoom: p.zoom, fit: p.fit, fitFill: p.fitFill })) }).replace(/</g, '\\u003c')}></script>
<script>import '../../../scripts/draft-editor';
import '../../../scripts/photo-reorder';</script>
