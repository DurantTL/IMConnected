---
import Admin from '../../layouts/Admin.astro';
import { SESSION_COOKIE, createSession, revokeSession, readSession, setSessionCookie } from '../../lib/auth/session';
import { dummyVerify, verifyPassword } from '../../lib/auth/password';
import { LOCKED_MESSAGE, clearOptionsRequests, isAccountLocked, isIpLocked, isLocked, recordSuccess, releaseAttempt, reserveAccountAttempt, reserveAttempt, reserveIpAttempt } from '../../lib/auth/ratelimit';
import { finishAuthentication, parseJson, passkeysEnabled } from '../../lib/auth/passkeys';
import { audit } from '../../lib/auth/audit';
import { field, readForm } from '../../lib/auth/form';
import { clientIp } from '../../lib/request';
import { getDb } from '../../lib/db';
import { PROVIDER_LABEL, enabledProviders } from '../../lib/auth/oauth';
export const prerender = false;

// Step 1 of sign-in: email + password. Success starts a session with mfa_passed=0 and goes to /admin/2fa.
// Every failure (unknown email, wrong password, disabled or not-yet-active account) gives the same text.
const BAD = 'Email or password is incorrect.';
let error = '';
let passkeyError = '';
let email = '';
const passkeys = passkeysEnabled();
// Google / Microsoft sign-in (issue #11). A button shows only for a configured provider. Failures arrive as ?oauth=<code>
// and map to fixed text here; nothing from the URL is ever printed.
const providers = enabledProviders();
const OAUTH_TEXT: Record<string, string> = {
  no_account: "This account isn't set up for IMConnected. Ask an admin for an invite",
  unverified: 'That provider hasn’t verified this email address, so it can’t be used to sign in.',
  locked: LOCKED_MESSAGE,
  expired: 'That sign-in request expired. Please try again.',
  unavailable: 'That sign-in method isn’t available on this site.',
  failed: 'Sign-in with that provider didn’t work. Please try again.',
};
const oauthCode = Astro.url.searchParams.get('oauth') || '';
let oauthError = '';
if (Astro.request.method === 'GET' && oauthCode) {
  oauthError = Object.hasOwn(OAUTH_TEXT, oauthCode) ? OAUTH_TEXT[oauthCode] : OAUTH_TEXT.failed;
  if (oauthCode === 'locked') Astro.response.status = 429;
  else if (oauthCode === 'no_account' || oauthCode === 'unverified') Astro.response.status = 401;
}

const existing = readSession(Astro.cookies.get(SESSION_COOKIE)?.value);
if (Astro.request.method === 'GET' && existing?.session.mfaPassed) return Astro.redirect('/admin');

if (Astro.request.method === 'POST') {
  const form = await readForm(Astro.request);
  const passkey = form ? field(form, 'passkey', 20000) : '';
  if (passkey) {
    // Passwordless: a passkey with user verification is both factors. The IP is counted before the first
    // await; the account is counted as soon as the credential names one (and refused if already locked).
    const ip = clientIp(Astro.request, Astro.clientAddress);
    if (isIpLocked(ip)) {
      passkeyError = LOCKED_MESSAGE;
      Astro.response.status = 429;
    } else {
      const reserved = reserveIpAttempt(ip);
      const res = await finishAuthentication(parseJson(passkey), 'login', null, (u) => {
        if (isAccountLocked(u.email)) return 'locked';
        reserved.push(...reserveAccountAttempt(u.email));
      });
      if (res.status === 'ok') {
        releaseAttempt(reserved);
        recordSuccess(res.email);
        clearOptionsRequests(ip);
        if (existing) revokeSession(existing.session.id);
        const { token } = createSession(res.userId, { ip, userAgent: Astro.request.headers.get('user-agent'), mfaPassed: true });
        setSessionCookie(Astro.cookies, token);
        audit('auth.login', { userId: res.userId, ip, detail: { method: 'passkey' } });
        return Astro.redirect('/admin', 303);
      }
      audit(res.status === 'counter' ? 'auth.passkey_counter_rejected' : 'auth.passkey_failed', {
        userId: res.userId ?? null,
        ip,
        detail: { reason: res.status, purpose: 'login' },
      });
      if (res.status === 'locked') {
        passkeyError = LOCKED_MESSAGE;
        Astro.response.status = 429;
      } else {
        passkeyError = res.status === 'expired' ? 'That sign-in request expired. Please try again.' : 'That passkey could not be verified.';
        Astro.response.status = 401;
      }
    }
  } else {
  email = form ? field(form, 'email', 320).trim().toLowerCase() : '';
  const password = form ? field(form, 'password', 1024) : '';
  const ip = clientIp(Astro.request, Astro.clientAddress);
  if (isLocked(ip, email)) {
    error = LOCKED_MESSAGE;
    Astro.response.status = 429;
  } else {
    const attempt = reserveAttempt(ip, email); // counted now, before any await (parallel guesses)
    const user = email
      ? (getDb().prepare(
          `SELECT u.id, u.status, p.hash FROM users u LEFT JOIN password_credentials p ON p.user_id = u.id WHERE u.email = ?`,
        ).get(email) as { id: number; status: string; hash: string | null } | undefined)
      : undefined;
    let ok = false;
    if (user?.hash && user.status === 'active') ok = await verifyPassword(password, user.hash);
    else await dummyVerify(password); // same scrypt cost whether or not the address exists
    if (!ok) {
      audit('auth.login_failed', { userId: user?.id ?? null, ip });
      error = BAD;
      Astro.response.status = 401;
    } else {
      releaseAttempt(attempt);
      if (existing) revokeSession(existing.session.id);
      const { token } = createSession(user!.id, { ip, userAgent: Astro.request.headers.get('user-agent'), mfaPassed: false });
      setSessionCookie(Astro.cookies, token);
      audit('auth.password_ok', { userId: user!.id, ip });
      return Astro.redirect('/admin/2fa', 303);
    }
  }
  }
}
---
<Admin title="Sign in">
  <h1>Editor sign-in</h1>
  {oauthError && <p class="admin-error" role="alert">{oauthError}</p>}
  <form class="admin-card" method="post" action="/admin/login">
    {error && <p class="admin-error" role="alert">{error}</p>}
    <p class="admin-note">Accounts are by invitation only.</p>
    <label for="email">Email</label>
    <input id="email" name="email" type="email" autocomplete="username" required maxlength="320" value={email} />
    <label for="password">Password</label>
    <input id="password" name="password" type="password" autocomplete="current-password" required maxlength="1024" />
    <button type="submit">Continue</button>
  </form>
  {providers.length > 0 && (
    <div class="admin-card oauth-card" role="group" aria-labelledby="oauth-h">
      <h2 id="oauth-h">Sign in with your work account</h2>
      <p class="admin-note">Only for editors who have been invited. You will still need your second step.</p>
      <ul class="oauth-list">
        {providers.map((p) => <li><a class="admin-button oauth-button" href={`/admin/oauth/${p}`}>Sign in with {PROVIDER_LABEL[p]}</a></li>)}
      </ul>
    </div>
  )}
  {passkeys && (
    <form class="admin-card passkey-card" method="post" action="/admin/login">
      <input type="hidden" name="passkey" value="" />
      <h2>Passkey</h2>
      <p class="admin-error" role="alert" data-passkey-error hidden={!passkeyError}>{passkeyError}</p>
      <p class="admin-note">Have a passkey on this device or a security key? Sign in without a password.</p>
      <button type="button" data-passkey="login" data-passkey-needs-js hidden>Sign in with a passkey</button>
    </form>
  )}
</Admin>
<script>import '../../scripts/passkeys';</script>
