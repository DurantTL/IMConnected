---
import Base from '../../layouts/Base.astro';
---
<Base title="Thank you" noindex>
  <div class="wrap">
    <header class="page-head">
      <span class="kicker">Story received</span>
      <h1>Thank you for sharing!</h1>
      <p>
        Your story has been sent to our editors. We review every submission and may reach out by email with questions.
        Once it’s approved, it will appear on IMConnected.
      </p>
    </header>
    <p><a class="btn" href="/">Back to stories</a> <a class="btn ghost" href="/submit/">Submit another</a></p>
  </div>
</Base>
