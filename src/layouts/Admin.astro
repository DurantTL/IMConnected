---
import '../styles/global.css';
import BrandMark from '../components/BrandMark.astro';
import { SITE } from '../lib/site';
import { countOpenDrafts } from '../lib/drafts';

interface Props {
  title: string;
  current?: 'dashboard' | 'drafts' | 'announcements' | 'events' | 'navigation' | 'published' | 'editors' | 'account';
  /** Wider main column (the story editor). */
  wide?: boolean;
}
const { title, current, wide } = Astro.props;
const user = Astro.locals.user;
const waiting: Record<string, number> = {};
if (user && Astro.locals.session?.mfaPassed) {
  try {
    waiting.drafts = countOpenDrafts('story'); waiting.announcements = countOpenDrafts('announcement'); waiting.events = countOpenDrafts('event');
  } catch {
    /* the badge is a convenience */
  }
}
const nav = [
  { key: 'drafts', href: '/admin', label: 'Stories' },
  { key: 'announcements', href: '/admin/announcements', label: 'Announcements' },
  { key: 'events', href: '/admin/events', label: 'Events' },
  { key: 'published', href: '/admin/published', label: 'Published' },
  { key: 'editors', href: '/admin/editors', label: 'Editors' },
  { key: 'account', href: '/admin/account', label: 'My account' },
  ...(user?.role === 'admin' ? [{ key: 'navigation', href: '/admin/navigation', label: 'Website menu' }] : []),
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} | {SITE.name} editors</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="admin">
    <a class="skip" href="#main">Skip to content</a>
    <header class="admin-bar">
      <a class="admin-brand" href="/admin"><BrandMark /><span class="admin-brand-kicker">Editorial workspace</span></a>
      {user && (
        <nav aria-label="Editor navigation">
          {Astro.locals.session?.mfaPassed && nav.map((n) => (
            <a href={n.href} aria-current={current === n.key ? 'page' : undefined}>{n.label}{waiting[n.key] > 0 && <span class="nav-count"><span aria-hidden="true">{waiting[n.key]}</span><span class="visually-hidden"> {waiting[n.key] === 1 ? 'draft' : 'drafts'} waiting</span></span>}</a>
          ))}
          <form method="post" action="/api/admin/logout"><button type="submit">Sign out</button></form>
        </nav>
      )}
      <a class="admin-public-link" href="/">View website <span aria-hidden="true">→</span></a>
    </header>
    <main id="main" class:list={['admin-main', { wide }]}>
      <slot />
    </main>
  </body>
</html>
<style is:global>
  .admin { background: var(--bg); }
  .admin-bar { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 24px; padding: 16px var(--gutter); background: var(--surface); color: var(--ink); border-bottom: 1px solid var(--line); }
  .admin-brand { display: grid; gap: 4px; font-family: var(--serif); font-weight: 700; font-size: 1.35rem; line-height: 1.15; color: var(--brand-text); text-decoration: none; min-height: 44px; align-content: center; }
  .admin-brand .admin-brand-kicker { font-family: var(--sans); font-weight: 700; font-size: .65rem; color: var(--ink-2); text-transform: uppercase; letter-spacing: .12em; }
  .admin-bar nav { display: flex; flex-wrap: wrap; align-items: center; gap: 4px; margin-left: auto; }
  .admin-bar nav a, .admin-bar nav button { justify-content: center; color: var(--ink-2); font: 600 .88rem var(--sans); background: none; border: 1px solid transparent; padding: 10px 12px; cursor: pointer; text-decoration: none; border-radius: 9px; }
  .admin-bar nav a:hover, .admin-bar nav button:hover { color: var(--brand-text); background: var(--surface-2); }
  .admin-bar nav a[aria-current] { color: var(--brand-text); background: var(--brand-soft); border-color: color-mix(in srgb, var(--brand) 18%, var(--surface)); }
  .admin-public-link { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 44px; padding: 8px 12px; border: 1px solid var(--line); border-radius: 9px; font-size: .85rem; font-weight: 600; text-decoration: none; color: var(--ink-2); }
  .admin-public-link:hover { color: var(--brand-text); border-color: var(--brand); }
  .admin-bar form { margin: 0; }
  .nav-count { display: inline-block; margin-left: 6px; min-width: 1.5em; padding: 0 6px; border-radius: 999px; background: var(--brand); color: var(--brand-ink); font-size: .75rem; font-weight: 700; text-align: center; line-height: 1.5; }
  .notify-check { display: flex !important; gap: 10px; align-items: center; min-height: 44px; }
  .notify-check input { width: 22px; height: 22px; }
  .admin-main { max-width: 760px; margin: 0 auto; padding: 32px var(--gutter) 64px; }
  .admin-main.wide { max-width: 1520px; }
  .admin-main h1 { font-family: var(--serif); margin-top: 0; }
  .admin-card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: clamp(20px, 3vw, 32px); box-shadow: var(--shadow-sm); }
  .admin-card label { display: block; font-weight: 600; margin: 16px 0 6px; }
  .admin-card input { width: 100%; padding: 10px 12px; font: inherit; border: 1px solid var(--line); border-radius: 8px; background: var(--bg); color: var(--ink); }
  .admin-card button { margin-top: 20px; padding: 10px 18px; font: inherit; font-weight: 600; border: 0; border-radius: 8px; background: var(--brand); color: var(--brand-ink); }
  .admin-card button:disabled { opacity: .5; }
  .admin-note { color: var(--ink-2); }
  .admin-main section.admin-card { margin: 0 0 24px; }
  .admin-main h2 { font-family: var(--serif); margin-top: 0; font-size: 1.2rem; }
  .admin-error, .admin-ok { padding: 10px 12px; border-radius: 8px; border: 1px solid; margin: 0 0 16px; font-weight: 600; }
  .admin-error { color: #8a1f11; background: #fdecea; border-color: #e5a39b; }
  .admin-ok { color: #1d5a2c; background: #e9f6ec; border-color: #9fcfaa; }
  .admin-button, .admin-main .admin-link { display: inline-block; padding: 10px 18px; font: inherit; font-weight: 600; border-radius: 8px; background: var(--brand); color: var(--brand-ink); text-decoration: none; }
  .admin-main .admin-link { background: none; color: var(--ink-2); border: 0; padding: 6px 0; text-decoration: underline; cursor: pointer; }
  .totp-qr { width: 220px; max-width: 100%; margin: 12px 0; background: #fff; border-radius: 8px; }
  .totp-qr svg { display: block; width: 100%; height: auto; }
  .totp-secret { display: block; padding: 10px 12px; background: var(--bg); border: 1px solid var(--line); border-radius: 8px; font-size: 1.05rem; letter-spacing: .08em; word-break: break-all; }
  .recovery-codes { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 8px 16px; padding-left: 1.4em; font-size: 1.05rem; }
  .session-list { list-style: none; padding: 0; margin: 0 0 8px; }
  .session-list li { display: flex; flex-wrap: wrap; gap: 8px 16px; justify-content: space-between; align-items: center; padding: 12px 0; border-top: 1px solid var(--line); overflow-wrap: anywhere; }
  .session-list form button { margin-top: 0; }
  .passkey-card { margin-top: 24px; }
  .passkey-inline { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; flex: 1 1 100%; }
  .passkey-inline input { flex: 1 1 200px; min-width: 0; padding: 8px 10px; font: inherit; border: 1px solid var(--line); border-radius: 8px; background: var(--bg); color: var(--ink); }
  .passkey-inline button { margin-top: 0; padding: 8px 14px; font: inherit; font-weight: 600; border: 0; border-radius: 8px; background: var(--brand); color: var(--brand-ink); cursor: pointer; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }

  /* Drafts inbox, published list and story editor */
  .cms-bar { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; justify-content: space-between; margin-bottom: 16px; }
  .cms-bar h1 { margin: 0; }
  .cms-filters { display: flex; flex-wrap: wrap; gap: 8px 12px; align-items: end; margin-bottom: 16px; }
  .cms-filters label { display: grid; gap: 4px; font-size: .85rem; font-weight: 600; }
  .cms-filters select, .ed select, .ed input[type=text], .ed input[type=date], .ed-photo input[type=text] { min-height: 44px; }
  .admin-bar nav a, .admin-bar nav button { display: inline-flex; align-items: center; min-height: 44px; }
  .cms-filters select, .ed select, .ed input[type=text], .ed input[type=date], .ed textarea, .ed-photo input[type=text], .ed input[type=file] { font: inherit; padding: 9px 10px; border: 1px solid var(--line); border-radius: 8px; background: var(--bg); color: var(--ink); max-width: 100%; }
  .cms-btn { display: inline-block; min-height: 44px; padding: 10px 16px; font: inherit; font-weight: 600; line-height: 1.2; border: 1px solid var(--brand); border-radius: 8px; background: var(--brand); color: var(--brand-ink); text-decoration: none; cursor: pointer; }
  .cms-btn.secondary { background: none; color: var(--brand-text); }
  .cms-btn.danger { background: none; color: #8a1f11; border-color: #8a1f11; }
  .cms-btn:disabled { opacity: .5; cursor: default; }
  .cms-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .cms-item { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 14px 16px; display: grid; gap: 6px; }
  .cms-item a.title { font-family: var(--serif); font-weight: 700; font-size: 1.1rem; text-decoration: none; overflow-wrap: anywhere; }
  .cms-item a.title:hover { text-decoration: underline; }
  .cms-meta { display: flex; flex-wrap: wrap; gap: 4px 8px; align-items: center; font-size: .85rem; color: var(--ink-2); }
  .cms-badge { display: inline-block; padding: 1px 8px; border-radius: 999px; border: 1px solid var(--line); background: var(--surface-2); font-size: .78rem; font-weight: 600; }
  .cms-badge.ok { color: #1d5a2c; background: #e9f6ec; border-color: #9fcfaa; }
  .cms-badge.warn { color: #7a4a00; background: #fff3dc; border-color: #e2c27d; }
  .cms-badge.bad { color: #8a1f11; background: #fdecea; border-color: #e5a39b; }
  .cms-actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 6px; }
  .cms-actions form { margin: 0; }
  .cms-home { display: grid; grid-template-columns: 1fr; gap: 16px; margin-bottom: 24px; }
  .cms-home h2 { margin: 0 0 8px; }
  .cms-home ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .cms-home li { display: grid; gap: 2px; overflow-wrap: anywhere; }
  @media (min-width: 760px) { .cms-home { grid-template-columns: 1fr 1fr; } }

  /* Bulk publish / unpublish (issue #88) */
  .bulk-bar { position: sticky; top: 0; z-index: 5; display: flex; flex-wrap: wrap; align-items: center; gap: 8px 16px; padding: 10px 12px; margin: 0 0 12px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow-sm); }
  .bulk-bar p { margin: 0; }
  .bulk-buttons { display: flex; flex-wrap: wrap; gap: 8px; }
  .bulk-buttons .cms-btn + .cms-btn { margin-left: 0; }
  .bulk-fields { display: grid; gap: 14px; margin: 0 0 16px; }
  .bulk-field { border: 1px solid var(--line); border-radius: var(--radius); padding: 12px; margin: 0; min-width: 0; }
  .bulk-sub { border-style: dashed; margin: 8px 0; }
  .bulk-field legend { font-weight: 700; padding: 0 6px; }
  .bulk-field label { display: flex; align-items: center; gap: 10px; min-height: 44px; }
  .bulk-field input[type=checkbox], .bulk-field input[type=radio] { width: 22px; height: 22px; margin: 0; flex: none; }
  .bulk-field select, .bulk-field input[type=date], .bulk-field textarea { min-height: 44px; max-width: 100%; font: inherit; }
  .bulk-changes { margin: 0 0 16px; padding-left: 1.2em; display: grid; gap: 6px; font-weight: 600; }
  .bulk-all { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; font-weight: 600; cursor: pointer; }
  .bulk-all[hidden], .bulk-count[hidden] { display: none; }
  .bulk-all input, .bulk-pick input { width: 22px; height: 22px; margin: 0; flex: none; }
  .bulk-count { font-weight: 700; }
  .bulk-help { flex: 1 1 100%; font-size: .85rem; color: var(--ink-2); }
  .bulk-row { display: flex; align-items: flex-start; gap: 4px; }
  .bulk-pick { display: inline-flex; align-items: center; justify-content: center; flex: none; width: 44px; min-height: 44px; cursor: pointer; }
  .bulk-body { display: grid; gap: 6px; min-width: 0; flex: 1; }
  .bulk-results { list-style: none; margin: 0 0 16px; padding: 0; display: grid; gap: 10px; }
  .cms-btn + .cms-btn { margin-left: 8px; }
  .bulk-reason { margin: 0; color: #8a1f11; font-weight: 600; }
  .bulk-titles { margin: 0 0 16px; padding-left: 1.2em; display: grid; gap: 6px; overflow-wrap: anywhere; }

  .ed { display: grid; gap: 20px; }
  .ed-card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 16px; min-width: 0; }
  .ed-card h2 { margin: 0 0 12px; font-size: 1.1rem; }
  .ed input[type=file] { width: 100%; }
  .ed-grid { display: grid; grid-template-columns: 1fr; gap: 12px; }
  .ed-grid label, .ed-field { display: grid; gap: 4px; font-weight: 600; font-size: .92rem; min-width: 0; }
  .ed-grid label span.hint { font-weight: 400; color: var(--ink-3); font-size: .8rem; }
  .ed-check { display: flex !important; gap: 8px; align-items: center; min-height: 44px; }
  .ed-check input { width: 22px; height: 22px; }
  .ed fieldset { border: 0; padding: 0; margin: 0; min-width: 0; }
  .ed-toolbar { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 8px; }
  .ed-toolbar button { min-width: 44px; min-height: 44px; padding: 6px 10px; font: inherit; border: 1px solid var(--line); border-radius: 8px; background: var(--surface-2); color: var(--ink); cursor: pointer; }
  .ed textarea.body { width: 100%; min-height: 320px; font: 16px/1.5 ui-monospace, SFMono-Regular, Menlo, monospace; resize: vertical; }
  .ed-tabs { display: none; gap: 8px; margin-bottom: 8px; }
  .ed-tabs button { flex: 1; min-height: 44px; font: inherit; font-weight: 600; border: 1px solid var(--line); border-radius: 8px; background: var(--surface-2); color: var(--ink); }
  .ed-tabs button[aria-pressed=true] { background: var(--brand); color: var(--brand-ink); border-color: var(--brand); }
  .ed-split { display: grid; grid-template-columns: 1fr; gap: 16px; }
  .ed-preview iframe { width: 100%; height: 420px; border: 1px solid var(--line); border-radius: 8px; background: #fff; }
  .ed-savebar { display: flex; flex-wrap: wrap; gap: 8px 12px; align-items: center; }
  .ed-status { font-size: .88rem; color: var(--ink-2); }
  .ed-photos { list-style: none; margin: 0 0 12px; padding: 0; display: grid; gap: 12px; }
  .ed-photo { display: grid; grid-template-columns: 96px 1fr; gap: 12px; padding: 12px; border: 1px solid var(--line); border-radius: 8px; background: var(--bg); }
  .ed-photo img { width: 96px; height: 96px; object-fit: cover; border-radius: 6px; background: var(--surface-2); }
  .ed-photo .fields { display: grid; gap: 8px; min-width: 0; }
  .ed-photo .fields input { width: 100%; }
  .ed-photo .ops { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 8px; }
  .ed-photo .ops button { min-height: 44px; padding: 6px 12px; font: inherit; border: 1px solid var(--line); border-radius: 8px; background: var(--surface-2); color: var(--ink); cursor: pointer; }
  .ed-photo .ops button.del { color: #8a1f11; }
  .ed-layouts { border: 0; margin: 16px 0 0; padding: 0; min-width: 0; }
  .ed-layouts legend { font-weight: 600; font-size: .92rem; padding: 0; margin-bottom: 4px; }
  .ed-layout-cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 10px; }
  .ed-layout { position: relative; display: grid; gap: 6px; align-content: start; padding: 10px; border: 2px solid var(--line); border-radius: 10px; background: var(--bg); cursor: pointer; min-height: 44px; }
  .ed-layout input { position: absolute; opacity: 0; inset: 0; width: 100%; height: 100%; margin: 0; cursor: pointer; }
  .ed-layout:has(input:checked) { border-color: var(--brand); background: var(--surface-2); }
  .ed-layout .lay-name::before { content: ''; display: inline-block; width: 1em; height: 1em; margin-right: 6px; vertical-align: -2px; border: 2px solid var(--ink-2); border-radius: 50%; box-sizing: border-box; }
  .ed-layout:has(input:checked) .lay-name::before { background: var(--brand); border-color: var(--brand); box-shadow: inset 0 0 0 2px var(--surface-2); }
  .ed-layout:has(input:checked) { box-shadow: inset 0 0 0 1px var(--brand); }
  @media (forced-colors: active) {
    .ed-layout { border-color: CanvasText; }
    .ed-layout:has(input:checked) { border-color: Highlight; box-shadow: none; outline: 3px solid Highlight; outline-offset: -6px; } /* an outline, so nothing moves */
    .ed-layout .lay-name::before { border-color: CanvasText; }
    .ed-layout:has(input:checked) .lay-name::before { background: Highlight; border-color: Highlight; box-shadow: inset 0 0 0 2px Canvas; }
    .lay-mini i, .ed-layout:has(input:checked) .lay-mini i { background: CanvasText; opacity: 1; }
    .ed-layout:has(input:checked) .lay-mini i { background: Highlight; }
    .ed-layout:has(input:focus-visible) { outline: 3px solid Highlight; }
  }
  .ed-layout:has(input:focus-visible) { outline: 3px solid var(--focus); outline-offset: 2px; }
  .ed-layout .lay-name { font-weight: 600; font-size: .92rem; }
  .ed-layout .lay-hint { font-size: .8rem; color: var(--ink-3); }
  .lay-mini { display: grid; gap: 3px; aspect-ratio: 4 / 3; }
  .lay-mini i { background: var(--ink-3); border-radius: 3px; opacity: .55; }
  .ed-layout:has(input:checked) .lay-mini i { background: var(--brand); opacity: .85; }
  .lay-twoUp { grid-template-columns: 1fr 1fr; }
  .lay-heroGrid { grid-template-columns: 1fr 1fr; grid-template-rows: 2fr 1fr; }
  .lay-heroGrid i:first-child { grid-column: 1 / -1; }
  .lay-mosaic { grid-template-columns: 1fr 1fr; grid-template-rows: 1fr 1fr; }
  .lay-stack { grid-template-rows: repeat(3, 1fr); }
  .ed-sub dl { display: grid; grid-template-columns: max-content 1fr; gap: 6px 12px; margin: 0; }
  .ed-sub dt { font-weight: 600; }
  .ed-sub dd { margin: 0; overflow-wrap: anywhere; }
  .ed details summary { cursor: pointer; font-weight: 600; min-height: 44px; display: flex; align-items: center; }
  .ed details textarea { width: 100%; min-height: 80px; }
  .ed-closed { background: var(--surface-2); }
  @media (max-width: 700px) {
    .admin-bar { gap: 12px; padding: 12px var(--gutter); }
    .admin-public-link { margin-left: auto; }
    .admin-bar nav { flex: 1 1 100%; order: 3; margin-left: 0; gap: 4px; }
    .admin-bar nav a, .admin-bar nav button { padding: 9px 10px; }
    .admin-main { padding-top: 24px; }
    .ed-sub dl { grid-template-columns: 1fr; gap: 3px; }
    .ed-sub dd { margin-bottom: 8px; }
  }
  @media (min-width: 640px) { .ed-grid { grid-template-columns: 1fr 1fr; } .ed-grid .full { grid-column: 1 / -1; } }
  @media (min-width: 900px) { .ed-split { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 899px) {
    .ed-tabs { display: flex; }
    .ed-split[data-view=write] .ed-preview { display: none; }
    .ed-split[data-view=preview] .ed-write { display: none; }
  }
</style>
