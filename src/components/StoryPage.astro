---
// The whole story page.
// The default slot is the rendered story body.
import { renderAnnouncementDetails } from '../lib/announcement-render';
import Base from '../layouts/Base.astro';
import StoryCard from './StoryCard.astro';
import { getSection, areaLabel, formatDate, SITE } from '../lib/site';
import StoryPhotos from './StoryPhotos.astro';
import type { PublicStory } from '../lib/stories';
import { photoLayoutOrDefault, planPhotos } from '../lib/photo-layouts';
import { storyBlockPhotos, photoFocusStyle } from '../lib/story-blocks';
import { INLINE_MEDIA_CSS } from '../lib/story-media-render';

interface Props {
  story: PublicStory;
  related: PublicStory[];
  inlinePhotoUrls?: Set<string>;
  inlinePhotoIndices?: Set<number>;
}
const { story, related } = Astro.props;
const d = story.data;
const section = getSection(d.section)!;
const sub = d.section === 'columns' ? d.column : areaLabel(d.section, d.area);
const subHref = d.area ? `/${d.section}/${d.area}/` : undefined;
const url = new URL(`/stories/${story.id}/`, Astro.site).href;
const enc = encodeURIComponent;

// Photo layout (issue #35). "one" (the default, and every story that has none) keeps the original look: the lead photo above
// the text and the others in a row under it. Another layout puts the lead and the others together above the text; photos it
// has no place for (a fifth in Hero + grid, a third in Two up) stay in the row under the text.
const layout = photoLayoutOrDefault(d.photoLayout);
const inlinePhotos = Astro.props.inlinePhotoUrls ?? new Set(storyBlockPhotos(d.storyBlocks ?? []).filter((b) => b.url && b.photoIndex === undefined).map((b) => b.url!));
const inlineIndices = Astro.props.inlinePhotoIndices ?? new Set<number>(storyBlockPhotos(d.storyBlocks ?? []).flatMap((p) => p.photoIndex !== undefined ? [p.photoIndex] : []));
const inlineCount = inlinePhotos.size + inlineIndices.size;
const allPhotos = [...(d.image ? [{ src: d.image, alt: d.imageAlt ?? '' }] : []), ...d.photos.map((src, i) => ({ src, alt: d.photoAlts[i] || '' }))]
  .map((p, i) => ({ ...p, ...d.photoFocus?.[i], alt: p.alt || `Photo ${i + (d.image ? 1 : 2)} from “${d.title}”` }))
  .filter((p, i) => !inlinePhotos.has(p.src) && !inlineIndices.has(i));
const plan = planPhotos(layout, allPhotos.length);
const laid = !d.announcement && plan.mode === 'layout' && (!!d.image || inlineCount > 0);
const galleryPhotos = laid ? plan.rest.map((i) => allPhotos[i]) : null;
const leadPhoto = d.image && !inlinePhotos.has(d.image) && !inlineIndices.has(0) ? allPhotos[0] : undefined;
const plainGallery = leadPhoto ? allPhotos.slice(1) : allPhotos;
const leadFocus = d.announcement ? undefined : photoFocusStyle(leadPhoto);
const announcementDetails = await renderAnnouncementDetails(d.announcement);
---
<Base title={d.title} description={d.dek} image={d.image} type="article" current={d.section}>
  <style is:inline slot="head" set:html={INLINE_MEDIA_CSS}></style>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'NewsArticle',
    headline: d.title,
    description: d.dek,
    datePublished: d.date.toISOString(),
    author: { '@type': 'Person', name: d.author },
    publisher: { '@type': 'Organization', name: SITE.publisher, url: SITE.publisherUrl },
    image: d.image ? new URL(d.image, Astro.site).href : undefined,
  }).replace(/</g, '\\u003c')} />
  <div class="wrap">
    <article class="article" data-sec={d.section}>
      <nav class="article-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href={`/${d.section}/`}>{section.label}</a></nav>
      <header class="article-heading">
      <div>
        <a class="kicker" href={`/${d.section}/`}>{section.label}</a>
        {sub && (<><span class="kicker"><span class="sep">/</span></span>{subHref ? <a class="kicker" href={subHref}>{sub}</a> : <span class="kicker">{sub}</span>}</>)}
        {(d.additionalSections ?? []).filter((key) => key !== d.section).map((key) => <><span class="kicker" aria-hidden="true"> · </span><a class="kicker" href={`/${key}/`}>{getSection(key)?.label}</a></>)}
      </div>
      <h1>{d.title}</h1>
      {d.dek && <p class="dek">{d.dek}</p>}
      <div class="byline">
        <span>By <strong>{d.author}</strong>{d.authorTitle && `, ${d.authorTitle}`}</span>
        {d.church && <span>{d.church}</span>}
        <time datetime={d.date.toISOString()}>{formatDate(d.date)}</time>
      </div>
      </header>

      {laid && <StoryPhotos layout={layout} plan={plan} photos={allPhotos} credit={d.photoCredit} />}

      {leadPhoto && !laid && (
        <figure>
          {d.announcement ? <a class="story-flyer" href={leadPhoto.src} data-photo aria-label={d.imageAlt?.trim() ? undefined : 'Enlarge flyer'}><img src={leadPhoto.src} alt={d.imageAlt ?? ''} loading="eager" style="width:100%;height:auto;object-fit:contain;" /></a> : (leadPhoto.zoom ?? 1) > 1 ? <a class="story-lead-crop" href={leadPhoto.src} data-photo aria-label={d.imageAlt?.trim() ? undefined : 'Enlarge story photo'}><img src={leadPhoto.src} alt={d.imageAlt ?? ''} loading="eager" style={`${leadFocus}aspect-ratio:16/9;object-fit:cover;`} /></a> : <img src={leadPhoto.src} alt={d.imageAlt ?? ''} loading="eager" style={leadFocus ? `${leadFocus}aspect-ratio:16/9;object-fit:cover;` : undefined} />}
          {(d.imageAlt || d.photoCredit) && (
            <figcaption>{d.imageAlt}{d.photoCredit && ` Photo: ${d.photoCredit}`}</figcaption>
          )}
        </figure>
      )}

      <Fragment set:html={announcementDetails} />
      <div class="prose">
        <slot />
      </div>

      {galleryPhotos && galleryPhotos.length > 0 && (
        <section class="gallery" aria-label="More photos">
          {galleryPhotos.map((p) => <a href={p.src}><img src={p.src} alt={p.alt} loading="lazy" decoding="async" style={photoFocusStyle(p)} /></a>)}
        </section>
      )}

      {!laid && plainGallery.length > 0 && (
        <section class="gallery" aria-label="Photos">
          {plainGallery.map((p) => <a href={p.src}><img src={p.src} alt={p.alt} loading="lazy" style={photoFocusStyle(p)} /></a>)}
        </section>
      )}

      {d.photoCredit && inlineCount > 0 && !laid && !leadPhoto && <p class="photo-credit">Photo: {d.photoCredit}</p>}

      <div class="share">
        <span>Share:</span>
        <a href={`https://www.facebook.com/sharer/sharer.php?u=${enc(url)}`} target="_blank" rel="noopener">Facebook</a>
        <a href={`mailto:?subject=${enc(d.title)}&body=${enc(url)}`}>Email</a>
        <button type="button" data-copy={url}>Copy link</button>
      </div>
    </article>

    {related.length > 0 && (
      <section class="block" data-sec={d.section}>
        <div class="block-head">
          <h2>More in {section.label}</h2>
          <a class="more" href={`/${d.section}/`}>See all →</a>
        </div>
        <div class="grid cols-3">{related.map((s) => <StoryCard story={s} />)}</div>
      </section>
    )}

    <section class="cta" aria-label="Submit a story">
      <div>
        <h2>Have a story to share?</h2>
        <p>We’d love to hear what God is doing in your church, school or club.</p>
      </div>
      <a class="btn accent" href="/submit/">Submit a Story</a>
    </section>
  </div>
</Base>
<script>
  import '../scripts/photo-viewer';
  import '../scripts/story-video';

  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) =>
    b.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(b.dataset.copy!);
        b.textContent = 'Link copied';
      } catch {
        b.textContent = 'Copy failed';
      }
    }),
  );
</script>
