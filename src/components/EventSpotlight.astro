---
import type { PublicStory } from '../lib/stories';
import { formatDate } from '../lib/site';
const { events } = Astro.props as { events: PublicStory[] };
---
{events.length > 0 && <section class="event-spotlight" aria-labelledby="spotlight-heading" data-event-spotlight>
  <div class="spotlight-heading"><div><p class="eyebrow">Gather. Connect. Belong.</p><h2 id="spotlight-heading">Coming together.</h2></div><div class="spotlight-controls"><a href="/announcements/">All announcements &amp; events <span aria-hidden="true">↗</span></a><div data-slider-controls hidden><button type="button" class="icon-btn" data-slide-step="-1" aria-label="Previous event">←</button><button type="button" class="icon-btn" data-slide-step="1" aria-label="Next event">→</button></div></div></div>
  <ul class="spotlight-track" tabindex="0" aria-label="Upcoming events. Scroll horizontally to explore." data-event-track>{events.map((event, i) => {
    const d = event.data, a = d.announcement!;
    return <li class="spotlight-slide" data-event-slide>
      <div class="spotlight-copy"><p class="spotlight-number">Coming up <span aria-hidden="true">/ 0{i + 1}</span></p><h3 class={d.title.length > 48 ? 'long' : d.title.length > 28 ? 'mid' : undefined}><a href={`/stories/${event.id}/`}>{d.title}</a></h3><div class="spotlight-details">{a.eventDate ? <time datetime={a.eventDate}>{formatDate(new Date(`${a.eventDate}T12:00:00Z`))}</time> : <span>Date to be announced</span>}{a.location && <span>{a.location}</span>}</div>{d.dek && <p class="spotlight-dek">{d.dek}</p>}<a class="spotlight-read" href={`/stories/${event.id}/`}>Explore event <span aria-hidden="true">→</span></a></div>
      {d.image ? <a class="spotlight-flyer" href={`/stories/${event.id}/`} aria-label={`View flyer: ${d.title}`}><img src={d.image} alt={d.imageAlt || ''} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" /></a> : <div class="spotlight-symbol" aria-hidden="true"><svg width="110" height="110" viewBox="0 0 100 100" fill="none"><rect x="12" y="20" width="76" height="68" rx="8" stroke="currentColor" stroke-width="3"/><path d="M28 10v22m44-22v22M12 42h76m-56 18 12 12 24-24" stroke="currentColor" stroke-width="3"/></svg><span>Gather.<br />Connect.<br />Belong.</span></div>}
    </li>;
  })}</ul>
  <div class="spotlight-navigation" data-slider-navigation hidden>
    <div class="spotlight-choices" role="group" aria-label="Choose an event">{events.map((event, i) => <button type="button" data-slide-to={i} aria-label={`Event ${String(i + 1).padStart(2, '0')}: ${event.data.title}`}>{String(i + 1).padStart(2, '0')}</button>)}</div>
    <button type="button" class="spotlight-play" data-slide-play data-state="playing" aria-label="Pause automatic advance"><svg class="icon-pause" aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><rect x="3" y="2" width="3.5" height="12" rx=".6"/><rect x="9.5" y="2" width="3.5" height="12" rx=".6"/></svg><svg class="icon-play" aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M4 2.2v11.6a.5.5 0 0 0 .77.42l9-5.8a.5.5 0 0 0 0-.84l-9-5.8A.5.5 0 0 0 4 2.2z"/></svg></button>
    <p class="spotlight-status sr-only" data-event-status role="status" aria-live="off" hidden></p>
  </div>
</section>}
<script>
  import '../scripts/event-spotlight';
</script>
