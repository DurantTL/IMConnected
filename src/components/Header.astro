---
import { SECTIONS, SITE } from '../lib/site';
const { current } = Astro.props as { current?: string };
---
<header class="site-header">
  <div class="wrap">
    <div class="bar">
      <a class="brand" href="/" aria-label={`${SITE.name} home`}>
        <span class="brand-name">IM<span>Connected</span></span>
        <span class="brand-sub">{SITE.publisher}</span>
      </a>
      <nav class="nav" aria-label="Sections">
        {SECTIONS.map((s) => (
          <a href={`/${s.key}/`} aria-current={current === s.key ? 'page' : undefined}>{s.label}</a>
        ))}
      </nav>
      <a class="icon-btn" href="/search/" aria-label="Search">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      </a>
      <a class="btn accent header-submit" href="/submit/">Submit a Story</a>
      <button class="icon-btn menu-toggle" type="button" aria-controls="mobile-nav" aria-expanded="false" aria-label="Menu">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
    <nav class="mobile-nav" id="mobile-nav" data-open="false" aria-label="Sections">
      {SECTIONS.map((s) => <a href={`/${s.key}/`}>{s.label}</a>)}
      <a href="/search/">Search</a>
      <a class="btn accent" href="/submit/">Submit a Story</a>
    </nav>
  </div>
</header>
<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.getElementById('mobile-nav');
  btn?.addEventListener('click', () => {
    const open = nav?.dataset.open !== 'true';
    if (nav) nav.dataset.open = String(open);
    btn.setAttribute('aria-expanded', String(open));
  });
</script>
