---
import BrandMark from './BrandMark.astro';
import { SITE } from '../lib/site';
import { defaultNavigation, currentNavigation } from '../lib/site-navigation';
import { readNavigation } from '../lib/navigation-store';
import { readPublicChrome } from '../lib/chrome-store';
import { defaultPublicChrome } from '../lib/site-chrome';
const { current } = Astro.props as { current?: string };
let items = defaultNavigation();
// Prerendered submission/search/error pages never open the database during a build.
if (!Astro.isPrerendered) { try { items = readNavigation().items; } catch { /* retain safe default links if settings are temporarily unavailable */ } }
const active = currentNavigation(items, Astro.url, current);
// Issue #156: editable text, links and visibility; prerendered pages render the defaults and refresh from the API.
const chrome = (Astro.isPrerendered ? defaultPublicChrome() : readPublicChrome()).header;
---
<header class="site-header" data-navigation-section={current}>
  {chrome.topLine && <div class="publication-line" data-chrome="topline"><div class="wrap"><span data-chrome-text="topline">{chrome.topLine.text}</span><a href={chrome.topLine.link.url} data-chrome-link="topline">{chrome.topLine.link.label} <svg aria-hidden="true" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17 17 7M7 7h10v10" /></svg></a></div></div>}
  <div class="masthead-band"><div class="wrap">
    <div class="bar">
      {chrome.mastheadNote && <p class="masthead-note" data-chrome="note">{chrome.mastheadNote[0]}<br />{chrome.mastheadNote[1]}<br /><strong>{chrome.mastheadNote[2]}</strong></p>}
      <a class="brand" href="/" aria-label={`${SITE.name} home`}>
        <BrandMark />
      </a>
      <div class="masthead-actions">
      {chrome.search && <a class="header-search" data-chrome="search" href="/search/" aria-current={current === 'search' ? 'page' : undefined}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <span>Search</span>
      </a>}
      {chrome.submit && <a class="btn accent header-submit" data-chrome="submit" href="/submit/">{chrome.submit}</a>}
      <button class="icon-btn menu-toggle" type="button" aria-controls="mobile-nav" aria-expanded="false" aria-label="Open menu">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
      </div>
    </div>
  </div></div>
  {chrome.strip && <div class="conference-strip" data-chrome="strip"><div class="wrap"><p><span aria-hidden="true" data-chrome-text="strip">{chrome.strip}</span><span class="sr-only">{SITE.publisher}</span></p></div></div>}
  <div class="wrap">
    <div class="section-nav-row"><nav class="nav" aria-label="Sections" data-navigation-items>
      {items.filter((i) => i.visible).map((i) => <a href={i.href} aria-current={active === i.id ? 'page' : undefined}>{i.label}</a>)}
    </nav>{chrome.edition && <span class="masthead-edition" data-chrome="edition">{chrome.edition}</span>}</div>
    <nav class="mobile-nav" id="mobile-nav" data-open="false" aria-label="Sections" inert>
      <div class="mobile-nav-inner"><div data-navigation-items>
        {items.filter((i) => i.visible).map((i) => <a href={i.href} aria-current={active === i.id ? 'page' : undefined}>{i.label}</a>)}
      </div>
      {chrome.search && <a data-chrome="search" href="/search/" aria-current={current === 'search' ? 'page' : undefined}>Search</a>}
      {chrome.submit && <a class="btn accent" data-chrome="submit" href="/submit/">{chrome.submit}</a>}
      </div>
    </nav>
  </div>
</header>
<script>
  import { normalizeNavigation, currentNavigation } from '../lib/site-navigation';
  import { applyChrome } from '../scripts/site-chrome-refresh';
  const btn = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.getElementById('mobile-nav');
  const setOpen = (open: boolean) => {
    if (nav) { nav.dataset.open = String(open); nav.inert = !open; }
    btn?.setAttribute('aria-expanded', String(open));
    btn?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  };
  btn?.addEventListener('click', () => {
    setOpen(nav?.dataset.open !== 'true');
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && nav?.dataset.open === 'true') {
      setOpen(false);
      btn?.focus();
    }
  });
  nav?.addEventListener('click', (event) => {
    if ((event.target as Element).closest('a')) setOpen(false);
  });
  matchMedia('(min-width: 921px)').addEventListener('change', (event) => {
    if (event.matches) setOpen(false);
  });
  // Refresh prerendered/cached headers too; failure retains the complete server-rendered menu.
  void fetch('/api/navigation', { credentials: 'omit', cache: 'no-store' }).then(async (response) => {
    if (!response.ok) return;
    const data = await response.json();
    try { applyChrome(data.chrome, document); } catch { /* keep the server-rendered header and footer */ }
    const items = normalizeNavigation(data.items), active = currentNavigation(items, new URL(location.href), document.querySelector<HTMLElement>('.site-header')?.dataset.navigationSection);
    for (const list of document.querySelectorAll('[data-navigation-items]')) {
      const links = items.filter((i) => i.visible).map((i) => { const a = document.createElement('a'); a.href = i.href; a.textContent = i.label; if (i.id === active) a.setAttribute('aria-current', 'page'); return a; });
      // Do not replace a keyboard user's focused menu link while the request finishes.
      if (!list.contains(document.activeElement)) list.replaceChildren(...links);
    }
  }).catch(() => {});
</script>
