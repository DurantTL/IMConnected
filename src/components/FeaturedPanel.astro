---
import { getSection, areaLabel, formatDate } from '../lib/site';
import { storyUrl, type PublicStory } from '../lib/stories';
import { photoFocusStyle, photoFrameAttrs } from '../lib/story-blocks';

interface Props { story?: PublicStory }
const { story } = Astro.props;
const d = story?.data;
const section = d && getSection(d.section);
const sub = d && (d.section === 'columns' ? d.column : areaLabel(d.section, d.area));
---
{story && d && (
  <section class="featured-panel" aria-labelledby="featured-title" data-featured-panel>
    <a class:list={['featured-link', { 'without-photo': !d.image }]} href={storyUrl(story)}>
      {d.image && (
        <div class="media" {...(photoFrameAttrs(d.photoFocus?.[0], d.image) ?? {})}>
          <img src={d.image} alt={d.imageAlt ?? ''} loading="lazy" decoding="async" style={photoFocusStyle(d.photoFocus?.[0])} />
        </div>
      )}
      <div class="featured-copy">
        <span class="eyebrow">Featured story</span>
        <span class="kicker" data-sec={d.section}>{section?.label}{sub && <><span class="sep">/</span>{sub}</>}</span>
        <h2 id="featured-title">{d.title}</h2>
        {d.dek && <p class="dek">{d.dek}</p>}
        <span class="meta">{d.church ? `${d.church} · ` : ''}{formatDate(d.date)}</span>
        <span class="card-read">Read the story <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 12h16m-6-6 6 6-6 6" /></svg></span>
      </div>
    </a>
  </section>
)}
