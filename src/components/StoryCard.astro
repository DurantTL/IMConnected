---
import { getSection, areaLabel, formatDate } from '../lib/site';
import { storyUrl, type PublicStory } from '../lib/stories';
import { photoFocusStyle, photoFrameAttrs } from '../lib/story-blocks';

interface Props {
  story: PublicStory;
  variant?: 'default' | 'lead' | 'compact' | 'text' | 'feature' | 'row';
  showDek?: boolean;
  showKicker?: boolean;
  /** Keep only the section label in the kicker, leaving out the area or column. */
  hideArea?: boolean;
  /**
   * What the kicker says. 'full' (default) is "Section / Area"; 'area' is for a section page
   * (the area only, or the primary section when the story is listed here as an additional
   * section); 'none' is for an area page.
   */
  kickerMode?: 'full' | 'area' | 'none';
  /** The section whose page this card is on (used by kickerMode 'area'). */
  pageSection?: string;
  /** Heading level override (a list with no lead story under the h1 uses h2). */
  heading?: 'h2' | 'h3';
}
const { story, variant = 'default', showDek = variant !== 'compact', showKicker = true, hideArea = false, kickerMode = 'full', pageSection, heading } = Astro.props;
const d = story.data;
const section = getSection(d.section);
const sub = hideArea ? '' : areaLabel(d.section, d.area);
const Heading = heading ?? (variant === 'lead' || variant === 'feature' ? 'h2' : 'h3');
// Kicker parts: "Section / Area" everywhere except the section and area pages.
let kickerSection: string | undefined = section?.label;
let kickerSub: string | undefined = sub;
if (kickerMode === 'area') {
  // Listed here as an additional section: say where it primarily lives ("News / Camp", or the section alone),
  // so an area name never reads like an area of this page's section.
  kickerSection = pageSection && d.section !== pageSection ? section?.label : undefined;
} else if (kickerMode === 'none') {
  kickerSection = undefined;
  kickerSub = undefined;
}
const kickerShown = showKicker && !!(kickerSection || kickerSub);
---
<a class:list={['card', variant, { 'with-photo': !!d.image, 'without-photo': !d.image }]} href={storyUrl(story)} data-sec={d.section} data-reveal>
  {variant !== 'text' && d.image && (
    <div class="media" {...(photoFrameAttrs(d.photoFocus?.[0], d.image) ?? {})}>
        <img src={d.image} alt={d.imageAlt ?? ''} loading={variant === 'lead' || variant === 'feature' ? 'eager' : 'lazy'} style={photoFocusStyle(d.photoFocus?.[0])} />
    </div>
  )}
  <div class="card-copy">
    {kickerShown && <span class="kicker">{kickerSection}{kickerSection && kickerSub && <span class="sep">/</span>}{kickerSub}</span>}
    <Heading>{d.title}</Heading>
    {showDek && d.dek && <p class="dek">{d.dek}</p>}
    <span class="meta">{d.author}{d.church ? ` · ${d.church}` : ''} · {formatDate(d.date)}</span>
    {variant === 'lead' && <span class="card-read">Read the story <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 12h16m-6-6 6 6-6 6" /></svg></span>}
  </div>
</a>
