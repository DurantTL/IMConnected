---
// The sticky bulk action bar (issue #88, extended in #89). The checkboxes live in the list and point at this form with form="bulk-form",
// so without JavaScript the bar is still a normal form that posts to the confirmation step. JavaScript only adds the
// "select all" checkbox and the "N selected" count. Each button carries its own action, so one selection can be
// published, rejected or edited (drafts), or unpublished or edited (live stories).
interface Props { action: string; label: string; noun: string; more?: { action: string; label: string; danger?: boolean }[] }
const { action, label, noun, more = [] } = Astro.props;
const buttons = [{ action, label, danger: action === 'unpublish' }, ...more];
---
<form class="bulk-bar" id="bulk-form" method="post" action="/admin/bulk" aria-label="Bulk actions">
  <label class="bulk-all" id="bulk-all-label" hidden><input type="checkbox" id="bulk-all" /> Select all on this page</label>
  <p class="bulk-count" id="bulk-count" role="status" hidden>0 selected</p>
  <div class="bulk-buttons">
    {buttons.map((b) => <button class={`cms-btn${b.danger ? ' danger' : ''}`} type="submit" name="action" value={b.action}>{b.label}</button>)}
  </div>
  <p class="bulk-help" id="bulk-help">Tick the {noun} you want, then choose an action. You will confirm on the next page. Up to 50 at a time.</p>
</form>
<script is:inline>
  // The list follows this bar in the page, so wait until it exists.
  document.addEventListener('DOMContentLoaded', function () {
    var form = document.getElementById('bulk-form');
    var all = document.getElementById('bulk-all');
    var count = document.getElementById('bulk-count');
    var items = Array.prototype.slice.call(document.querySelectorAll('input.bulk-item'));
    if (!form || !all || !count || !items.length) return;
    var MAX = 50;
    document.getElementById('bulk-all-label').hidden = false;
    count.hidden = false;
    var buttons = Array.prototype.slice.call(form.querySelectorAll('button[type=submit]'));
    function update() {
      var n = items.filter(function (i) { return i.checked; }).length;
      count.textContent = n + ' selected' + (n > MAX ? '. Only ' + MAX + ' can be done at once, untick some.' : '');
      buttons.forEach(function (b) { b.disabled = n === 0 || n > MAX; });
      var first = items.slice(0, MAX);
      all.checked = first.length > 0 && first.every(function (i) { return i.checked; });
      all.indeterminate = !all.checked && n > 0;
    }
    all.addEventListener('change', function () {
      items.forEach(function (i, idx) { i.checked = all.checked && idx < MAX; });
      update();
    });
    items.forEach(function (i) { i.addEventListener('change', update); });
    if (items.length > MAX) document.getElementById('bulk-help').textContent += ' "Select all" picks the first ' + MAX + ' on the page.';
    update();
  });
</script>
