---
import BrandMark from './BrandMark.astro';
import { SECTIONS, SITE } from '../lib/site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap">
    <div class="footer-statement"><p>Connected by community.<br /><em>Inspired by faith.</em></p><a class="btn" href="/submit/">Share your story <span aria-hidden="true">↗</span></a></div>
    <div class="cols">
      <div>
        <a class="brand" href="/">
          <BrandMark />
        </a>
        <p class="footer-intro">{SITE.tagline}. A publication of the <a href={SITE.publisherUrl}>{SITE.publisher}</a>.</p>
      </div>
      <div>
        <h2>Sections</h2>
        <ul>
          {SECTIONS.map((s) => <li><a href={`/${s.key}/`}>{s.label}</a></li>)}
        </ul>
      </div>
      <div>
        <h2>Get involved</h2>
        <ul>
          <li><a href="/submit/">Submit a story</a></li>
          <li><a href="/search/">Search stories</a></li>
          <li><a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a></li>
          <li><a href={SITE.publisherUrl}>imsda.org</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <p class="fine">© {year} {SITE.publisher}. All rights reserved.</p>
      <a class="footer-editor" href="/admin">Editor sign in <span aria-hidden="true">→</span></a>
    </div>
  </div>
</footer>
