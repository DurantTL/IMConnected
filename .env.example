# Public URL of the site (used for canonical links and the submit form's origin check)
SITE_URL=https://stories.imadventist.org

# Where the editor database (accounts, sessions, drafts, audit log) lives. Defaults to ./data;
# the Docker image sets /data, which is a named volume. Back this folder up.
# DATA_DIR=./data

# --- Story submissions → GitHub pull requests ---
# Fine-grained personal access token scoped to THIS repo only, with:
#   Contents: Read and write   ·   Pull requests: Read and write
GITHUB_TOKEN=
# owner/repo
GITHUB_REPO=DurantTL/imconnected
GITHUB_BASE_BRANCH=main
# Label added to every submission PR (create it in the repo first, or leave blank)
GITHUB_PR_LABEL=story-submission

# Optional: post a message to a Discord channel when a story comes in
DISCORD_WEBHOOK_URL=

# Behind Cloudflare / Nginx Proxy Manager / Traefik? Set true so rate limiting uses the real client IP.
TRUST_PROXY=true
# Max submissions per IP per hour
SUBMIT_RATE_LIMIT=10
# Extra hostnames allowed to post the form (comma-separated), e.g. a staging domain
ALLOWED_ORIGINS=

# --- Spam protection and confirmation email (see the README) ---
# Cloudflare Turnstile secret key: Cloudflare dashboard -> Turnstile -> your widget -> Secret key.
# Unset skips the check (local dev only). The matching PUBLIC site key is NOT set here: it is the
# repository variable PUBLIC_TURNSTILE_SITE_KEY, baked in at build time.
TURNSTILE_SECRET_KEY=
# Resend (https://resend.com) API key and a sender on a domain verified in Resend. Unset RESEND_API_KEY skips sending.
RESEND_API_KEY=
EMAIL_FROM=IMConnected <stories@imadventist.org>
# Optional; defaults to communication@imsda.org
EMAIL_REPLY_TO=
# Signs the confirmation links. 32+ characters, e.g. `openssl rand -hex 32`. Without it no email is sent.
EMAIL_CONFIRM_SECRET=

# --- Publishing from IMConnected Studio (POST /api/publish) ---
# Shared secret Studio sends as a Bearer token. 32+ random characters, e.g. `openssl rand -hex 32`.
# Unset or shorter than 32 characters turns publishing off (503). The GITHUB_TOKEN above is reused
# and needs Contents: Read and write on the base branch.
PUBLISH_TOKEN=
# Browser origins allowed to call the API (comma-separated)
PUBLISH_ORIGINS=https://tools.imsda.org

# Testing only: point at the mock API (node scripts/mock-github.mjs)
# GITHUB_API_URL=http://localhost:4010
# Local mock of the Resend endpoint (never send real email while testing)
# EMAIL_API_URL=http://localhost:4011/emails
# Local stand-in for Cloudflare siteverify, if the test keys can't be reached
# TURNSTILE_VERIFY_URL=http://localhost:4012/siteverify
